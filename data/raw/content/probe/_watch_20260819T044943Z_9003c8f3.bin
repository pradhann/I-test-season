rmas:\n\nSpotify: https://bit.ly/FFCAST\nDeezer: https://www.deezer.com/br/show/3766997\n\n-----------------------------------------------------------------------------------------------------------------------------------\nNos siga nas nossas outras redes:\n\nInstagram: \nFilipe Frazão:   / filipefrazao1  \nCarol Frazão:   / carolbxfrazao  \n\nTiktok: https://vm.tiktok.com/ZMNUoX5eF/","commandRuns":[{"startIndex":564,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBcQ040EGAciEwis-YaO8quWAxVSlcsBHe5rG0JI3riDv72LhZFPygEEM9gjbA==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVG9WZEttTWpVaUNLa0pGNUxwSTlyZ3xBR3JiS2FtcWE3OTRtR1N3aHp3VTJzcFBtX1RRMWM5QVk0OVlkb3FVWm5OaWZkUEM4RGxHbWNXODFSWWdFR29odVBzVDFaOGVSZzM0blJ3RTFIeEpmZ1JaOXM0QUR1UjBCclRx\u0026q=https%3A%2F%2Fbit.ly%2FFFCAST\u0026v=TyIUW9fg3F4","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVG9WZEttTWpVaUNLa0pGNUxwSTlyZ3xBR3JiS2FtcWE3OTRtR1N3aHp3VTJzcFBtX1RRMWM5QVk0OVlkb3FVWm5OaWZkUEM4RGxHbWNXODFSWWdFR29odVBzVDFaOGVSZzM0blJ3RTFIeEpmZ1JaOXM0QUR1UjBCclRx\u0026q=https%3A%2F%2Fbit.ly%2FFFCAST\u0026v=TyIUW9fg3F4","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":594,"length":38,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBcQ040EGAciEwis-YaO8quWAxVSlcsBHe5rG0JI3riDv72LhZFPygEEM9gjbA==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVEdxbGlIYWNXMmRpajZTX1NGOTB3MHxBR3JiS2FuZDBKQ2VYbjZRQmQ2TnZMSFFkcU9kdjZCaERtVW1xQ25OR1hkQWo1dGVVRGZBN2J5SllTdkw5Z2ZURlZGWWVMT0Z0Uk83T0w5NlBocEZBM19jVlY1cVJZbFowSXhT\u0026q=https%3A%2F%2Fwww.deezer.com%2Fbr%2Fshow%2F3766997\u0026v=TyIUW9fg3F4","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_