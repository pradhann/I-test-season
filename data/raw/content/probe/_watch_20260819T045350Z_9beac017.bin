g the biggest debates? And did anyone actually manage to agree on their FPL team?! 😂\n\nLet us know in the comments: WHO is your must-have FPL player for 2026/27? 👇\n\n#FPL #FantasyPremierLeague #FPL2026 #FPLTips #FPLFamily","commandRuns":[{"startIndex":694,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCoQ3NcEGB4iEwjw7ueD86uWAxUwhIoHHeyOGXDKAQQ8OlM2","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fpl","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUHCgNmcGwYAQ%3D%3D"}}},"loggingDirectives":{"trackingParams":"CCoQ3NcEGB4iEwjw7ueD86uWAxUwhIoHHeyOGXA="}},{"startIndex":699,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCkQ3NcEGB8iEwjw7ueD86uWAxUwhIoHHeyOGXDKAQQ8OlM2","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fantasypremierleague","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUYChRmYW50YXN5cHJlbWllcmxlYWd1ZRgB"}}},"loggingDirectives":{"trackingParams":"CCkQ3NcEGB8iEwjw7ueD86uWAxUwhIoHHeyOGXA="}},{"startIndex":721,"length":8,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCgQ3NcEGCAiEwjw7ueD86uWAxUwhIoHHeyOGXDKAQQ8OlM2","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fpl2026","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gULCgdmcGwyMDI2GAE%3D"}}},"loggingDirectives":{"trackingParams":"CCgQ3NcEGCAiEwjw7ueD86uWAxUwhIoHHeyOGXA="}},{"startIndex":730,"length":8,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCcQ3NcEGCEiEwjw7ueD86uWAxUwhIoHHeyOGXDKAQQ8OlM2","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fpltips","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gULCgdmcGx0aXBzGAE%3D"}}},"loggingDirectives":{"trackingParams":"CCcQ3NcEGCEiEw