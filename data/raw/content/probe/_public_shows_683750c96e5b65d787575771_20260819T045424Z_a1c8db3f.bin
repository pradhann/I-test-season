			<pubDate>Fri, 03 Dec 2021 11:13:00 GMT</pubDate>
			<itunes:duration>27:40</itunes:duration>
			<enclosure url="https://sphinx.acast.com/p/open/s/683750c96e5b65d787575771/e/ee3048f8-3815-11ec-abc7-773dd3b4ae93/media.mp3" length="39880041" type="audio/mpeg"/>
