			<itunes:duration>35:17</itunes:duration>
			<enclosure url="https://sphinx.acast.com/p/open/s/683750c96e5b65d787575771/e/5c2af494-624b-11eb-b2fc-f38e19e24ce1/media.mp3" length="50873444" type="audio/mpeg"/>
