			<pubDate>Tue, 28 Sep 2021 10:19:00 GMT</pubDate>
			<itunes:duration>32:46</itunes:duration>
			<enclosure url="https://sphinx.acast.com/p/open/s/683750c96e5b65d787575771/e/7742e9e4-0bd8-11ec-a5e0-9fb1b8551fee/media.mp3" length="47233776" type="audio/mpeg"/>
