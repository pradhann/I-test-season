pleText":"Western Frisian"}},{"languageCode":"wo","languageName":{"simpleText":"Wolof"}},{"languageCode":"xh","languageName":{"simpleText":"Xhosa"}},{"languageCode":"yi","languageName":{"simpleText":"Yiddish"}},{"languageCode":"yo","languageName":{"simpleText":"Yoruba"}},{"languageCode":"zu","languageName":{"simpleText":"Zulu"}}],"defaultAudioTrackIndex":17}},"videoDetails":{"videoId":"lBUr8DGSj-U","title":"I asked 100 FPL Experts for their Gameweek 1 teams, and this is what I found out... | FPL 2026/27","lengthSeconds":"1778","keywords":["fpl","fantasy premier league","premier league","fpl gameweek","fpl captain","fpl wildcard","fpl draft","fantasy football","fpl mate","fplmate","fpl tips","fpl advice","fantasy premier league tips","fpl free hit","fpl first draft","premier league fantasy","fpl podcast","fpl team","fpl squad","fantasy pl","fol","epl fantasy","fpl team selection","fpl transfers","fpl transfer tips","best team","fpl 2025","fpl dan","gameweek 1","gw 1","game week 1","gw1 fpl","gw1","week 1","fpl 26/27","fpl 2027"],"channelId":"UCweDAlFm2LnVcOqaFU4_AGA","isOwnerViewing":false,"shortDescription":"Win your league or your money back 👉 https://go.fantasyfootballhub.co.uk/landing/fplmate?utm_source=affiliate\u0026utm_medium=affiliates\u0026utm_campaign=FPLMate\u0026utm_content=youtube\u0026via=FPLMate #ad\n\nWelcome to THE BIG Fantasy Premier League video for GW1, 2026/27!\n\nI asked 100 FPL experts, podcasters, bloggers, writers and YouTubers to send me their gameweek 1 squad drafts. I recorded all of the data from all 100 teams, so I could work out a bunch of information that I could share with you. We have found out who the most popular players are, which formation is the most popular, who is most popular captain, and much more.\n\n0:00 Intro\n0:52 Goalkeepers\n3:59 Defenders\n8:05 Midfielders\n10:54 Forwards\n13:21 Top picks\n14:57 Formations\n15:52 Key decisions\n22:00 Overrated picks\n25:22 Underrated picks\n26:42 GW1 Captains\n\nIf you like what you see, subscribe and become my latest mate!\n\n📧 Business enquiries: dan@fplmate.co.uk\n\n🐦 https://www.twitter.com/FPLMate\n📸 https://www.instagram.com/FPLMate\n🎙️ Podcast: linktr.ee/sticktofpl\n🎶 https://www.tiktok.com/@FPLMate\n🎮 https://www.twitch.tv/fpl_mate\n👾 https://discord.gg/rfVSeftbmx\n🏆 Join: https://www.youtube.com/channel/UCweDAlFm2LnVcOqaFU4_AGA/join\n️⚽️ FPL Mate league link: https://fantasy.premierleague.com/leagues/auto-join/kxxssl\n️⚽️ FPL Mate league code: kxxssl\n\n#fpl #fantasypremierleague #premierleague","isCrawlable":true,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/lBUr8DGSj-U/hqdefault.jpg?sqp=-oaymwEiCKgBEF5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLAbe5sL9d8UPqPveLYk72cBhpBxfg","width":168,"height":94},{"url":"https://i.ytimg.com/vi/lBUr8DGSj-U/hqdefault.jpg?sqp=-oaymwEiCMQBEG5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLCaFCP7_luYiIiXQ3nVoqBUydf5MA","width":196,"height":110},{"url":"https://i.ytimg.com/vi/lBUr8DGSj-U/hqdefault.jpg?sqp=-oaymwEjCPYBEIoBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLCwygdVqq-vavdyA-JcGL_MKjlg8Q","width":246,"height":138},{"url":"https://i.ytimg.com/vi/lBUr8DGSj-U/hqdefault.jpg?sqp=-oaymwEjCNACELwBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLDHmtTImsjnddwFkEbXEGvlE7XeDA","width":336,"height":188},{"url":"https://i.ytimg.com/vi/lBUr8DGSj-U/maxresdefault.jpg","width":1920,"height":1080}]},"allowRatings":true,"viewCount":"60622","author":"FPL Mate","isPrivate":false,"isUnpluggedCorpus":false,"isLiveContent":false,"isTvfilmVideo":false},"annotations":[{"playerAnnotationsExpandedRenderer":{"featuredChannel":{"startTimeMs":"15000","endTimeMs":"1757000","watermark":{"thumbnails":[{"url":"https://i.ytimg.com/an/weDAlFm2LnVcOqaFU4_AGA/featured_channel.jpg?v=64f1aeae","width":40,"height":40}]},"trackingParams":"CBMQ8zciEwibor-P8quWAxXtTF4DHQ2oMfk=","navigationEndpoint":{"clickTrackingParams":"CBMQ8zciEwibor-P8quWAxXtTF4DHQ2oMfkyAml2ygEEM9gjbA==","commandMetadata":{"