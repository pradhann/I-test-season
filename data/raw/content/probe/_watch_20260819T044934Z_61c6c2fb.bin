ncel"},"trackingParams":"CMgCEPBbIhMI9cHUifKrlgMVFYCKBx19zBQH"}},"primaryIsCancel":false}},"popupType":"DIALOG"}}]}}]}},"metadataRowContainer":{"metadataRowContainerRenderer":{"collapsedItemCount":0,"trackingParams":"CMICEM2rARgBIhMI9cHUifKrlgMVFYCKBx19zBQH"}},"showMoreText":{"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"trackingParams":"CMICEM2rARgBIhMI9cHUifKrlgMVFYCKBx19zBQH","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CMICEM2rARgBIhMI9cHUifKrlgMVFYCKBx19zBQHygEEM9gjbA==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CMICEM2rARgBIhMI9cHUifKrlgMVFYCKBx19zBQHygEEM9gjbA==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CMICEM2rARgBIhMI9cHUifKrlgMVFYCKBx19zBQHygEEM9gjbA==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CMICEM2rARgBIhMI9cHUifKrlgMVFYCKBx19zBQHygEEM9gjbA==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"A relaxed chat with Nico and James about some more light hearted topics from the World of football. Nico reveals his FPL Draft including a treble up on the Tractor Boys, James wants Savinho and Cody Gakpo at Tottenham - but could Gakpo be going to Real Madrid!?\n\nPlus, Donald Trump finally gives his backing to Gianni Infantino, Evangelos Marinakis is suing Crystal Palace for a banner displayed in the home end when Forest went there last season, the national coach who has two wives, James has a theory on weddings and funerals, Cristiano Ronaldo does some things that gains respect, but could he actually retire soon?\n\nAnd Fabrizio Romano is getting annoying, the player in Brazil who had an unfortunate mishap after scoring, Rodri going to Barcelona, players stopping to greet fans, Brennan Johnson at Everton, media criticism of players and more.\n\n---------------------------------------------------------------------------------\nIntro: 0:00\nNico's FPL Team: 1:11\n\"Cody Gakpo\" to Real Madrid: 9:47\nTrump backs Infantino: 12:53\nMarinakis Sues Crystal Palace: 15:39\nEgypt Head Coach Rushed to Hospital: 20:03\nRonaldo Gets Married: 22:46\nRonaldo Supports Messi: 27:00\nFabrizio Romano QUITS?: 28:43\nFootballer falls into a hole: 35:08\nRodri boards Ryanair flight: 41:26\nBeto buys kids sweets: 45:03\nBrennan Johnson FIGHTS back: 45:58\nOutro: 52:43\n----------------------------------------------------------------------------------\n\nTomorrow on Planet FPL: s.10 ep.4 'The Line Ups'\n\nToday on Patreon: Money in Football (IT+) \u0026What The Numbers Say (AT)\n\nThe full Planet FPL schedule for this week can be found via this post:   / content-schedule-166900524  \n\nWant to become a member of our FPL community and support the Podcast? \n\nJoin us on Patreon: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow James on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfplpod⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Suj on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / sujanshah⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Clayton on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / claytsafc⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow David on Twitter/x: https://x.com/PlanetFPLHunter\n\nFollow Nico on Twitter/x:   / nico_semedo  \n\nSubscribe to our YouTube channel: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠   / @planetfpl  \n\nLike us on Facebook: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠