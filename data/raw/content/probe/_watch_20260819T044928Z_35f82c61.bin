rris Heller - Cielo\n━━━━━━━━━━━━━\n#FPL #FantasyPremierLeague #PremierLeague","commandRuns":[{"startIndex":35,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwiOqeaG8quWAxUV-tIEHUHKAIhIhue6yOP6t5R4ygEEM9gjbA==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUVhVZzFIc1hSbnNoS3VwQWVUVldlRXxBR3JiS2FtaEt6VFFuOGhpYTNIem5XRzltX2UySU5PdVNCTGRveFdWTVM4Mm52ZTNmZFNaclExMkxLUEY5bU1GTURZVlR5ZTJBZ0t2MnJDdllfQTZzVEwycHNobV9lREtYaHFj\u0026q=https%3A%2F%2Fs.id%2FFPLFocal\u0026v=eCjf1jkOs4Y","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUVhVZzFIc1hSbnNoS3VwQWVUVldlRXxBR3JiS2FtaEt6VFFuOGhpYTNIem5XRzltX2UySU5PdVNCTGRveFdWTVM4Mm52ZTNmZFNaclExMkxLUEY5bU1GTURZVlR5ZTJBZ0t2MnJDdllfQTZzVEwycHNobV9lREtYaHFj\u0026q=https%3A%2F%2Fs.id%2FFPLFocal\u0026v=eCjf1jkOs4Y","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":277,"length":18,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwiOqeaG8quWAxUV-tIEHUHKAIhIhue6yOP6t5R4ygEEM9gjbA==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUlJGaWZ1YlBJcUk4YVhzeU92QllFMHxBR3JiS2FuMlBlcmdyaTZHSXBaYVNVZzRnUjZ3dkw2ajZjLTlMVDVJbmljd2NXTFB1VDlickdzSXh4LTNFaTl4TDNySDlhWElkaGJLX0Z0NG1IZmhaVk55RGVPSEwzU3A2SWJW\u0026q=https%3A%2F%2Fs.id%2FFocal\u0026v=eCjf1jkOs4Y","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUlJGaWZ1YlBJcUk4YVhzeU92QllFMHxBR3JiS2FuMlBlcmdyaTZHSXBaYVNVZzRnUjZ3dkw2ajZjLTlMVDVJbmljd2NXTFB1VDlickdzSXh4LTNFaTl4TDNySDlhWElkaGJLX0Z0NG1IZmhaVk55RGVPSEwzU3A2SWJW\u0026q=https%3A%2F%2Fs.id%2FFocal\u0026v=eCjf1jkOs4Y","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":330,"length":33,"onTap":{"innertubeComm