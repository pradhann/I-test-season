ews"},"publishDate":{"simpleText":"Premiered 12 hours ago"},"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAYiEwj5vuSE86uWAxUOCdsBHS1ILy7KAQQ8OlM2","commandMetadata":{"webCommandMetadata":{"url":"/@FPLBlackBox","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCGJ8-xqhOLwyJNuPMsVoQWQ","canonicalBaseUrl":"/@FPLBlackBox"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/vcfLQFV4YPNWlLEKHWqiUJnvduo59gy1pLKrvZSk187evBECSb4TlRNpXdSh3JcdcqNqddvR=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Az talks through his team ahead of the upcoming GW1 deadline! Vuskovic? Wirtz? Chris Richards?! All are covered.\n---\nDon't forget to Like this video, Subscribe to the Channel... or why not become a Channel member?!\n---\n🟢 All team / player stats shown on screen are from Fantasy Football Scout. Az, Andy, and Luke all use the Fantasy Football Scout members area to get their data and help make their decisions. You can sign up and get instant access to this elite Fantasy data here: https://bit.ly/FFScoutBlackBox\n----------------------------------------------\n👍 🖋️ Don't forget to Like this video and Subscribe to FPL Blackbox… https://bit.ly/3jwrN96\n\n⬛ … and join the FPL BlackBox league!\nCode: m6h64h\n----------------------------------------------\n🎫 Become a Channel Member and/or become a Godfather Tier member on Patreon!\n\nJoin the community on Patreon!: www.patreon.com/fplblackbox      \n\nWe greatly appreciate all SuperChats as a way of supporting the stream! We will do our best to answer these at the end of the stream\n----------------------------------------------\nFollow us:\n\n🅾 INSTAGRAM: www.instagram.com/FPLBlackBox\n\n💻 DISCORD:     / discord  \n\n🐦X: https://www.x.com/fplblackbox\n-----------------------------------------------\n#FPLBlackBox #FPL #FantasyPremierLeague #premierleague #GW1 Fantasy Football Scout, Fantasy Football Tips, Fantasy Football Gameweek 1 GW 1\n-----------------------------------------------\nContact us: \n\n📧 Az@fplblackbox.com\n📧 Andy@fplblackbox.com","commandRuns":[{"startIndex":483,"length":30,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwj5vuSE86uWAxUOCdsBHS1ILy5I44Hkqb2aoKfrAcoBBDw6UzY=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUnJranZNZDRCdzItenFxaDNpOWUycHxBR3JiS2FucUhrOGtiMURCLUphQzZTeXA4UzUxZ3Yycl9sSGFpNGhrRVFJS2dQMU91a2ZvZjdWcjN3bklZdWdlUU9KX2RYelkyX3R3SmQ5UURmSm5YNU9ubWMzZ3dsRkJ0QUdT\u0026q=https%3A%2F%2Fbit.ly%2FFFScoutBlackBox\u0026v=606A09U5AOM","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUnJranZNZDRCdzItenFxaDNpOWUycHxBR3JiS2FucUhrOGtiMURCLUphQzZTeXA4UzUxZ3Yycl9sSGFpNGhrRVFJS2dQMU91a2ZvZjdWcjN3bklZdWdlUU9KX2RYelkyX3R3SmQ5UURmSm5YNU9ubWMzZ3dsRkJ0QUdT\u0026q=https%3A%2F%2Fbit.ly%2FFFScoutBlackBox\u0026v=606A09U5AOM","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":631,"length":22,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwj5vuSE86uWAxUOCdsBHS1ILy5I44Hkqb2aoKfrAcoBBDw6UzY=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rU3ExQUpaaTZMS1c1ZWtXOVhvazN5dnxBR3JiS2FsWnlSdFZBTmdKMkdFQVFiSk9PSjNOSG00cHlkNnZjQVpmcEdQMVFsLXJxUE1FSTNCNkswc2lhQW1aa0VrbmJTMmRKMHFEQTNlT1FnV1FuUzhfNXJsZ2ZiTXB0LVQ2\u0026q=https%3A%2F%2Fbit.ly%2F3jwrN96\u0026v=606A09U5AOM","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rU3ExQUpaaTZMS1c1ZWtXOVhvazN5dnxBR3JiS2FsWnlSdFZBTmdKMkdFQVF