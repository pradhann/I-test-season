      <pubDate>Tue, 03 Aug 2021 13:30:57 -0000</pubDate>
      <itunes:title>Interview w/ Ross Dowsett (@FPL__Raptor) | Meet the Manager | FPL 21/22</itunes:title>
      <itunes:episodeType>full</itunes:episodeType>
