      <itunes:title>FPL GAMEWEEK 20 SCOUTCAST | Best De Bruyne replacements? | Fantasy Premier League Tips 2020/21</itunes:title>
      <itunes:episodeType>full</itunes:episodeType>
      <itunes:episode>10</itunes:episode>
