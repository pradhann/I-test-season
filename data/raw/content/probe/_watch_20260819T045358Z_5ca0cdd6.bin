fplmate  \n📸   / fplmate  \n🎙️ Podcast: linktr.ee/sticktofpl\n🎶   / fplmate  \n🎮   / fpl_mate  \n👾   / discord  \n🏆 Join:    / @fplmate  \n️⚽️ FPL Mate league link: https://fantasy.premierleague.com/lea...\n️⚽️ FPL Mate league code: kxxssl\n\n#fpl #fantasypremierleague #premierleague","commandRuns":[{"startIndex":38,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwiFsNOH86uWAxVFUfIAHaQhBR9I5Z_KjIP-yoqUAcoBBDw6UzY=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUnN6bVhMVWxpYWtoWFBZM2dmN3NVeXxBR3JiS2FsMWh0RDZjY2NMaVN2c3BNeFFzRHRKX2xzM1FsRXYxZ2ZCREl4Sy1Uek15TXZESm9hSUU0RHA5WldROHhNaG5vYXVLUF84cXRBbTVtdlozMWduMmF6T1YtSzlTczQy\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Flanding%2Ffplmate%3Futm_source%3Daffiliate%26utm_medium%3Daffiliates%26utm_campaign%3DFPLMate%26utm_content%3Dyoutube%26via%3DFPLMate\u0026v=lBUr8DGSj-U","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUnN6bVhMVWxpYWtoWFBZM2dmN3NVeXxBR3JiS2FsMWh0RDZjY2NMaVN2c3BNeFFzRHRKX2xzM1FsRXYxZ2ZCREl4Sy1Uek15TXZESm9hSUU0RHA5WldROHhNaG5vYXVLUF84cXRBbTVtdlozMWduMmF6T1YtSzlTczQy\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Flanding%2Ffplmate%3Futm_source%3Daffiliate%26utm_medium%3Daffiliates%26utm_campaign%3DFPLMate%26utm_content%3Dyoutube%26via%3DFPLMate\u0026v=lBUr8DGSj-U","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":79,"length":3,"onTap":{"innertubeCommand":{"clickTrackingParams":"CDUQ3NcEGDYiEwiFsNOH86uWAxVFUfIAHaQhBR_KAQQ8OlM2","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/ad","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUGCgJhZBgB"}}},"loggingDirectives":{"trackingParams":"CDUQ3NcEGDYiEwiFsNOH86uWAxVFUfIAHaQhBR8="}},{"startIndex":515,"length":4,"onTap":{"innertube