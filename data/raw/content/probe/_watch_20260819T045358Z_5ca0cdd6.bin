ype":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCweDAlFm2LnVcOqaFU4_AGA","canonicalBaseUrl":"/@FPLMate"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/qAQEk85x07sEvJWq1fo1ldbHQSKaIbTYlQF9ncIiym36qbHD1KLimJA2TQLtGmNYOZLaLyDTEA=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Win your league or your money back 👉 https://go.fantasyfootballhub.co.uk/l... #ad\n\nWelcome to THE BIG Fantasy Premier League video for GW1, 2026/27!\n\nI asked 100 FPL experts, podcasters, bloggers, writers and YouTubers to send me their gameweek 1 squad drafts. I recorded all of the data from all 100 teams, so I could work out a bunch of information that I could share with you. We have found out who the most popular players are, which formation is the most popular, who is most popular captain, and much more.\n\n0:00 Intro\n0:52 Goalkeepers\n3:59 Defenders\n8:05 Midfielders\n10:54 Forwards\n13:21 Top picks\n14:57 Formations\n15:52 Key decisions\n22:00 Overrated picks\n25:22 Underrated picks\n26:42 GW1 Captains\n\nIf you like what you see, subscribe and become my latest mate!\n\n📧 Business enquiries: dan@fplmate.co.uk\n\n🐦   / fplmate  \n📸   / fplmate  \n🎙️ Podcast: linktr.ee/sticktofpl\n🎶   / fplmate  \n🎮   / fpl_mate  \n👾   / discord  \n🏆 Join:    / @fplmate  \n️⚽️ FPL Mate league link: https://fantasy.premierleague.com/lea...\n️⚽️ FPL Mate league code: kxxssl\n\n#fpl #fantasypremierleague #premierleague","commandRuns":[{"startIndex":38,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwiFsNOH86uWAxVFUfIAHaQhBR9I5Z_KjIP-yoqUAcoBBDw6UzY=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVENBMmU3RkV2VDhCR