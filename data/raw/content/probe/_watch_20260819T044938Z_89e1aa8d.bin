7,"overlayBackground":3422762301},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAYiEwiN18-L8quWAxVhSfIAHfLfF3jKAQQz2CNs","commandMetadata":{"webCommandMetadata":{"url":"/@FPLFamily","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCDG_EqOaaO1SSxEMZwfrSkg","canonicalBaseUrl":"/@FPLFamily"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/fvXRj8Lye-E-52gmDDmkCErlCuXT-vDI9kvKkN1_pWsEUPzuN7ieOQtjDo_-JiyuLQa4p9Arug=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Pre-season FPL planning got a LOT more fun… 😅 Lee \u0026 Sam head down to Brighton to spend the weekend with our FPL friends Az from FPL BlackBox and Yelena — and, naturally, we ended up talking A LOT about Fantasy Premier League!\n\nIn this video, we’ve pulled together the best bits from the trip: FPL 2026/27 tips, player picks, team ideas and strategy for the new season, mixed with a behind-the-scenes vlog of what we got up to together in Brighton. 🌊⚽️\n\nWho are Az, Yelena, Lee and Sam backing for GW1? Which players are causing the biggest debates? And did anyone actually manage to agree on their FPL team?! 😂\n\nLet us know in the comments: WHO is your must-have FPL player for 2026/27? 👇\n\n#FPL #FantasyPremierLeague #FPL2026 #FPLTips #FPLFamily","commandRuns":[{"startIndex":694,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCoQ3NcEGB4iEwiN18-L8quWAxVhSfIAHfLfF3jKAQQz2CNs","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fpl","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUHCgNmcGwYAQ%3D%3D"}}},"loggingDirectives":{"trackingP