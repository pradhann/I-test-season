 Intro\n00:30 Haaland\n08:39 Goalkeepers\n10:23 Defenders\n18:37 Midfielders\n26:49 Wirtz\n30:47 Forwards\n34:42 Team Rating\n36:08 Overall Team Thoughts\n38:37 AI Transfers\n41:32 Final Thoughts\n━━━━━━━━━━━━━\nFOLLOW US 👇\n🎯 Site: https://fantasyfootballhub.co.uk/\n🐦 Hub Twitter:   / ffh_hq  \n📸 Instagram:   / ffh_hq  \n✅ TikTok:   / ffh_hq  \n🔵 Facebook:   / ffootballhub  \n🐦 Jack's Twitter:   / redditoryt  \n🐦 Will's Twitter:   / ffh_will  \n🐦 Edited By Stevo:   / editor_stevo  \n━━━━━━━━━━━━━\nABOUT 💭\nFantasy Football Hub brings you the very best Fantasy Premier League tools, players, writers, bloggers and content creators under one roof. If you're looking for fantasy football advice, we are the channel for you.\n\n#FPL #FantasyPremierLeague #PremierLeague","commandRuns":[{"startIndex":36,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CJQCEM2rARgBIhMI1MjehvOrlgMV69SVAh0c_SGeSPLA9YqDtOuZYcoBBDw6UzY=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUl9Bd2VWQkF0Y2VUSmtDRlZhZ0x2RHxBR3JiS2FtZkE4NFVlc0FPV2tQQkltbzNiS2ZUQjR1RmVJSUgwV2pxYzdBVl9OXzZFR0EybFByQWt6akNsOHdKeUR4MzBJcTg4U3hZY3hlWlpoanVBRjVlelFua0RQRWhPNWlt\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Fai-team-rating%3Futm_source%3Dyoutube%26utm_medium%3Dhubyoutube%26utm_campaign%3Djack26%26via%3Djack26\u0026v=YTOtoDFdYHI","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUl9Bd2VWQkF0Y2VUSmtDRlZhZ0x2RHxBR3JiS2FtZkE4NFVlc0FPV2tQQkltbzNiS2ZUQjR1RmVJSUgwV2pxYzdBVl9OXzZFR0EybFByQWt6akNsOHdKeUR4MzBJcTg4U3hZY3hlWlpoanVBRjVlelFua0RQRWhPNWlt\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Fai-team-rating%3Futm_source%3Dyoutube%26utm_medium%3Dhubyoutube%26utm_campaign%3Djack26%26via%3Djack26\u0026v=YTOtoDFdYHI","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":241,"length":5,"onTap":{"innertube