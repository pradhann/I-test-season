279846543,"overlayBackground":3423214390},"darkThemeColorPalette":{"baseBackground":4278324252,"raisedBackground":4278852406,"additiveBackground":725972681,"textPrimary":4292930298,"textSecondary":4289511133,"invertedBackground":4286358499,"overlayBackground":3423214390},"enableColorSampledText":true}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"EgtGQzF5SVNIR2M1TSDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"12,463"},"label":{"simpleText":"Views"},"accessibilityText":"12,463 views","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293981695,"raisedBackground":4293981695,"additiveBackground":558200521,"textPrimary":4278852406,"textSecondary":4282011246,"invertedBackground":4279846543,"overlayBackground":3423214390},"darkThemeColorPalette":{"baseBackground":4278324252,"raisedBackground":4278852406,"additiveBackground":725972681,"textPrimary":4292930298,"textSecondary":4289511133,"invertedBackground":4286358499,"overlayBackground":3423214390},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"Aug 17"},"label":{"simpleText":"2026"},"accessibilityText":"Aug 17, 2026","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293981695,"raisedBackground":4293981695,"additiveBackground":558200521,"textPrimary":4278852406,"textSecondary":4282011246,"invertedBackground":4279846543,"overlayBackground":3423214390},"darkThemeColorPalette":{"baseBackground":4278324252,"raisedBackground":4278852406,"additiveBackground":725972681,"textPrimary":4292930298,"textSecondary":4289511133,"invertedBackground":4286358499,"overlayBackground":3423214390},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAciEwiqr6-C86uWAxWElIoHHQivKsXKAQQ8OlM2","commandMetadata":{"webCommandMetadata":{"url":"/@PlanetFPL","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UC8043oOKTB4uP8Nq15Kz6bg","canonicalBaseUrl":"/@PlanetFPL"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/ytc/AIdro_lhavFK4dKciK04L6ggAxAX9Q9_AnrPDcvbJCV1_3RdVQ=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"With Correspondent Week done and each club having now played their final pre-season fixture, Suj and James discuss what's left with a definitive guide to their Shortlist of players under consideration and those who may appeal to others.\n\nThere's discussion on favoured early season strategy, James gives us a wrap of all the key information from the final friendlies and opinions that may have evolved from the Correspondent Week podcasts and then there's coverage of every position and price point and who the preferred choices are.\n\n---------------------------------------------------------------------------------\nIntro: 0:00\nContent Schedule: 1:30\nThe Teams: 4:30\nSummary of weekend friendlies: 10:04\nBig 3: 26:15\nGoalkeepers: 30:46\n6.5 DEFs: 38:02\n6.0 DEFs: 42:08\n5.5 DEFs: 44:46\n5.0 DEFs: 49:02\n4.5 DEFs: 54:41\n4.0 DEFs: 59:14\n8.0-9.5 MIDs: 1:01:05\n7.5 MIDs: 1:06:00\n7.0 MIDs: 1:08:14\n6.5 MIDs: 1:10:32\n6.0 MIDs: 1:16:31\n5.5 MIDs: 1:20:05\n4.5-5.0 MIDs: 1:22:14\n6.5-9.0 FWDs: 1:28:52\n6.0 FWDs: 1:32:06\n4.5-5.5 FWDs: 1:35:11\nOutro: 1:37:34\n----------------------------------------------------------------------------------\n\nTomorrow on Planet FPL: That Show With Nico ep. 16\n\nToday on Patreon: Patreon QNA (IT+) \u0026 Nico's Corner (AT)\n\nThe full Planet FPL schedule for this week can be found via this post:   / content-schedule-166900524  \n\nWant to become a member of our FPL community and support the Podcast? \n\nJoin us on Patreon: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow James on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfplpod⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Suj on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / sujanshah⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Clayton on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / claytsafc⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow David on Twitter/x: https://x.com/PlanetFPLHunter\n\nFollow Nico on Twitter/x:   / nico_semedo  \n\nSubscribe to our YouTube channel: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠   / @planetfpl  \n\nLike us on Facebook: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow us on Instagram: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\n#FPL #FantasyPremierLeague","commandRuns":[{"startIndex":624,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwiqr6-C86uWAxWElIoHHQivKsXKAQQ8OlM2","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=FC1yISHGc5M","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"FC1yISHGc5M","continuePlayback":true,"startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr1---sn-a5mekn6s.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026olis=1\u0026ofpcc=1\u0026msp=1\u0026odepv=1\u0026id=142d722121c67