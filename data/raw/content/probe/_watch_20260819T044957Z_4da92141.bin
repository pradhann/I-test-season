x.com/FPL_TomHadley\n\n👇 Don’t forget to like 👍, subscribe 🔔, and comment 💬 to support the channel and stay up to date with the latest FPL content!\n\nTimecodes\n0:00 = Intro \n\n\n#FPL #FantasyPremierLeague #premierleague #fantasyfootball","isCrawlable":true,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/Q6AwFqhUr5w/hqdefault.jpg?sqp=-oaymwEiCKgBEF5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLCbrJuUt-sUb04tyGXAfhAdseRgMQ","width":168,"height":94},{"url":"https://i.ytimg.com/vi/Q6AwFqhUr5w/hqdefault.jpg?sqp=-oaymwEiCMQBEG5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLCi4bIoxEbL3rpwsOQOeYVlr8BsHA","width":196,"height":110},{"url":"https://i.ytimg.com/vi/Q6AwFqhUr5w/hqdefault.jpg?sqp=-oaymwEjCPYBEIoBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLDt_OzW8IEDrF0MMefu4pRO5Besgw","width":246,"height":138},{"url":"https://i.ytimg.com/vi/Q6AwFqhUr5w/hqdefault.jpg?sqp=-oaymwEjCNACELwBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLAKBdvIMn16qYoSdtA_37Nl4l1FZw","width":336,"height":188},{"url":"https://i.ytimg.com/vi/Q6AwFqhUr5w/maxresdefault.jpg","width":1920,"height":1080}]},"allowRatings":true,"viewCount":"2127","author":"FPL Tom","isPrivate":false,"isUnpluggedCorpus":false,"isLiveContent":false,"isTvfilmVideo":false},"annotations":[{"playerAnnotationsExpandedRenderer":{"featuredChannel":{"startTimeMs":"0","endTimeMs":"896000","watermark":{"thumbnails":[{"url":"https://i.ytimg.com/an/14BPCP-fxIDuG0I_dC2Kpg/featured_channel.jpg?v=63d7eb63","width":40,"height":40}]},"trackingParams":"CAkQ8zciEwix_-GU8quWAxUGJbMFHQMWJwc=","navigationEndpoint":{"clickTrackingParams":"CAkQ8zciEwix_-GU8quWAxUGJbMFHQMWJwcyAml2ygEEM9gjbA==","commandMetadata":{"webCommandMetadata":{"url":"/channel/UC14BPCP-fxIDuG0I_dC2Kpg","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UC14BPCP-fxIDuG0I_dC2Kpg"}},"channelName":"FPL Tom","subscribeButton":{"subscribeButtonRenderer":{"buttonText":{"runs":