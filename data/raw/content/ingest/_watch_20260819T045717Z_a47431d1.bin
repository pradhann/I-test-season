d":4285707245,"overlayBackground":3422757181},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"Aug 16"},"label":{"simpleText":"2026"},"accessibilityText":"Aug 16, 2026","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293982463,"raisedBackground":4293982463,"additiveBackground":556633057,"textPrimary":4278395197,"textSecondary":4279392150,"invertedBackground":4279392150,"overlayBackground":3422757181},"darkThemeColorPalette":{"baseBackground":4278259742,"raisedBackground":4278395197,"additiveBackground":724405217,"textPrimary":4292734717,"textSecondary":4287940340,"invertedBackground":4285707245,"overlayBackground":3422757181},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAYiEwiiqMfm86uWAxWrojUBHRSRBkXKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/@FPLFamily","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCDG_EqOaaO1SSxEMZwfrSkg","canonicalBaseUrl":"/@FPLFamily"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/fvXRj8Lye-E-52gmDDmkCErlCuXT-vDI9kvKkN1_pWsEUPzuN7ieOQtjDo_-JiyuLQa4p9Arug=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"HAALAND OR NO HAALAND?! 😱 Lee is seriously considering going WITHOUT Erling Haaland for GW1…\n\n\nIs going against the FPL template the ultimate differential — or a disaster waiting to happen? 👀\n\n\nGW1 is almost here, so tonight we're putting our latest FPL drafts under the microscope and making some BIG decisions for the opening Gameweek!\n\n\n🔴 LIVE TONIGHT – Sunday 16th August at 9pm\n\n\nOn this week's FPL Family stream:\n\n\n⚽ GW1 DRAFTS – See where our squads are currently at and what we're still tinkering with.\n\n\n🔥 LEE'S HAALAND DILEMMA – Is Lee really going without Haaland? What are the alternatives, and could going against the template give him an early advantage?\n\n\n🏆 COMMUNITY SHIELD \u0026 PRE-SEASON – What did we learn from the Community Shield and this week's Premier League friendlies? Which players have caught our eye?\n\n\n👀 LAST-MINUTE FPL WATCHLIST – Who are we considering before the Gameweek 1 deadline?\n\n\n🔮 OUR 2026/27 FPL \u0026 PREMIER LEAGUE PREDICTIONS – We're making our predictions for the season, sealing them in an envelope and locking them away for 38 Gameweeks! We'll look back at them at the end of the season to see just how wrong we were 😂\n\n\n💬 YOUR TURN! Who wins the Premier League? Who gets the most FPL points? Who's the surprise breakout player? And most importantly… HAALAND OR NO HAALAND?\n\n\nDrop your predictions in the live chat and comments!\n\n\nSam and Lee are back for their TENTH SEASON of FPL Family! 🎉\n\n\nWhether you're a seasoned FPL manager or you're playing Fantasy Premier League for the first time, we're here to help you make those final GW1 decisions, find the best players and hopefully avoid those early-season disasters!\n\n\nA massive THANK YOU for all your support watching, liking and sharing our videos ❤️\n\n\n---\n\n\n🚀 SUPPORT FPL FAMILY ON PATREON\n\n\nJoin our FPL community for FREE or support the channel and get access to:\n\n\n     \n     \n  •  \n     \n     Exclusive FREE Podcasts every week looking ahead to the next GW\n     \n     \n     \n  •  \n     \n     Manager of the Month Competitions – MONTHLY PRIZES!\n     \n     \n     \n  •  \n     \n     Zoom Video Chats with Lee and Sam\n     \n     \n     \n  •  \n     \n     Slack Chat community with other FPL Managers\n     \n     \n     \n\n👉   (https://www.youtube.com/redirect?even...)  / fplfamily   (https://www.youtube.com/redirect?even...) \n\n---\n\n📊 JOIN THE FPL FAMILY FPL MINI-LEAGUE!\n\nLeague Code: 55fqu1\n\n---\n\nJoin us over on FOOTIUM\n\nhttps://footium.club/game/social/frie... (https://www.youtube.com/redirect?even...) \n\n---\n\n🎧 LISTEN TO THE FPL FAMILY PODCAST\n\nAlso available on your favourite podcast platforms:\n\n  (https://www.youtube.com/redirect?even...)  / fplfamily   (https://www.youtube.com/redirect?even...) \nhttps://audioboom.com/channels/5010221 (https://www.youtube.com/redirect?even...) \n\nSearch 'FPL Family' on Spotify, Apple Podcasts and Deezer.\n\n---\n\n📈 FPL STATS \u0026 PLAYER RATINGS\n\nStats, Season Tickers and Player Ratings provided by Fantasy Football Scout Members Area.\n\nBecome a member here:\nhttp://Bit.ly/FFScoutFamily (https://www.youtube.com/redirect?even....","commandRuns":[{"startIndex":2229,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwiiqMfm86uWAxWrojUBHRSRBkVIzuvWq5j7ofWLAcoBBFwAzMk=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUVhnMHczaVRiaWxWVEpHQUpZR0hTTXxBR3JiS2FtRmNvaHdtcUpqVnNUSDRVNzlmT215ckFhYUg2TzkxQkVZRjM1d3pEMW03bzQyZm8zNVRUV3VFWGdjc0VUUTFNU1hCYWJfSEN2RnAxS3A0NVhBRU5iYm96cWxRME51\u0026q=https%3A%2F%2Fwww.patreon.com%2Ffplfamily\u0026v=2_Mj7p7Yvu0","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUVhnMHczaVRiaWxWVEpHQUpZR0hTTXxBR3JiS2FtRmNvaHdtcUpqVnNUSDRVNzlmT215ckFhYUg2TzkxQkVZRjM1d3pEMW03bzQyZm8zNVRUV3VFWGdjc0VUUTFNU1hCYWJfSEN2RnAxS3A0NVhBRU5iYm96cWxRME51\u0026q=https%3A%2F%2Fwww.patreon.com%2Ffplfamily\u0026v=2_Mj7p7Yvu0","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":2287,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwiiqMfm86uWAxWrojUBHRSRBkVIzuvWq5j7ofWLAcoBBFwAzMk=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u002