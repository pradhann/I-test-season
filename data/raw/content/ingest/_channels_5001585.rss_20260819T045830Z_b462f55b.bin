<item>
  <title>S9 Ep1: FPL Pod: Welcome back FPL 2026/27</title>
  <link>https://audioboom.com/posts/8931599</link>
  <itunes:episode>1</itunes:episode>
  <itunes:title>FPL Pod: Welcome back FPL 2026/27</itunes:title>
  <itunes:season>9</itunes:season>
  <enclosure url="https://audioboom.com/posts/8931599.mp3?modified=1784881443&amp;sid=5001585&amp;source=rss" length="43042545" type="audio/mpeg" />
