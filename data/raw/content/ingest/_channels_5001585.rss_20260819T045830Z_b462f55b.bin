  <link>https://audioboom.com/posts/8903444</link>
  <itunes:episode>48</itunes:episode>
  <itunes:title>FPL Pod: Arsenal attack or defence?</itunes:title>
  <itunes:season>8</itunes:season>
  <enclosure url="https://audioboom.com/posts/8903444.mp3?modified=1778760530&amp;sid=5001585&amp;source=rss" length="42331541" type="audio/mpeg" />
