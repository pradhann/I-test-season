<style>
  .notice-banner-wrapper {
    --notice-green: var(--color-primary, #008f5b);
    --notice-purple: var(--color-secondary, #662d90);
  }

  .notice-banner-wrapper .notice-banner-shell {
    overflow: hidden;
  }

  .notice-banner-wrapper .notice-banner {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 106px;
    align-items: center;
    overflow: hidden;
    color: #111318;
    background:
      radial-gradient(circle at 8% 0%, rgba(255, 255, 255, 0.92), transparent 31%),
      radial-gradient(circle at 92% 100%, rgba(255, 255, 255, 0.72), transparent 34%),
      linear-gradient(112deg, #d9fff0 0%, #71e3b3 34%, #c39cdd 68%, #eadcf5 100%);
    border: 1px solid rgba(102, 45, 144, 0.16);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.68),
      0 10px 28px rgba(63, 32, 79, 0.13);
  }

  .notice-banner-wrapper .notice-banner::before {
    position: absolute;
    z-index: -1;
    top: -90%;
    bottom: -90%;
    left: -32%;
    width: 18%;
    content: '';
    transform: rotate(18deg);
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    animation: ffsNoticeSweep 6s ease-in-out infinite;
  }

  .notice-banner-wrapper .notice-banner::after {
    position: absolute;
    z-index: -2;
    inset: 0;
    content: '';
    opacity: 0.1;
    background-image:
      linear-gradient(rgba(17, 19, 24, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(17, 19, 24, 0.18) 1px, transparent 1px);
    background-size: 24px 24px;
    -webkit-mask-image: linear-gradient(90deg, #000, transparent 42%, transparent 58%, #000);
    mask-image: linear-gradient(90deg, #000, transparent 42%, transparent 58%, #000);
  }

  .notice-banner-wrapper .notice-banner-orb {
    position: absolute;
    z-index: -1;
    display: block;
    width: 210px;
    height: 210px;
    border-radius: 999px;
    filter: blur(55px);
    opacity: 0.2;
    pointer-events: none;
  }

  .notice-banner-wrapper .notice-banner-orb-green {
    top: -145px;
    left: -25px;
    background: var(--notice-green);
  }

  .notice-banner-wrapper .notice-banner-orb-purple {
    right: 5%;
    bottom: -160px;
    background: var(--notice-purple);
  }

  .notice-banner-wrapper .notice-banner-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 14px;
    pointer-events: none;
  }

  .notice-banner-wrapper .notice-banner-hit-area {
    position: absolute;
    z-index: 4;
    inset: 0;
    border-radius: inherit;
    cursor: pointer;
  }

  .notice-banner-wrapper .notice-banner-hit-area:focus-visible {
    outline: 3px solid rgba(102, 45, 144, 0.7);
    outline-offset: -4px;
  }

  .notice-banner-wrapper .notice-banner-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    text-align: center;
  }

  .notice-banner-wrapper .notice-banner-kicker {
    display: none;
    align-items: center;
    gap: 9px;
    flex: 0 0 auto;
    padding: 4px 10px 4px 5px;
    border: 0;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.74);
    color: #171615;
    font-size: 10px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.86),
      0 4px 14px rgba(63, 32, 79, 0.1);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .notice-banner-wrapper .notice-banner-mascot {
    position: relative;
    display: block;
    overflow: hidden;
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
    border-radius: 6px;
    box-shadow: 0 3px 8px rgba(0, 91, 58, 0.2);
  }

  .notice-banner-wrapper .notice-banner-mascot img {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: auto;
    height: 33.55px;
    max-width: none;
  }

  .notice-banner-wrapper .notice-banner-message {
    max-width: 760px;
    margin: 0 !important;
    color: #111318;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: balance;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.66);
  }

  .notice-banner-wrapper .notice-banner-message.is-message-ready {
    animation: ffsNoticeMessageIn 0.48s cubic-bezier(0.2, 0.75, 0.25, 1) both;
  }

  .notice-banner-wrapper .notice-banner-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    flex: 0 0 auto;
    min-height: 35px;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    background: linear-gradient(135deg, #7f3dad, var(--notice-purple)) !important;
    color: #fff !important;
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    text-decoration: none !important;
    white-space: nowrap;
    box-shadow: 0 0 0 0 rgba(102, 45, 144, 0.48), 0 8px 20px rgba(48, 25, 60, 0.3);
    animation: ffsNoticeCtaPulse 2.8s ease-in-out infinite;
    transition: transform 160ms ease, background 160ms ease, box-shadow 160ms ease;
  }

  .notice-banner-wrapper .notice-banner-cta-arrow {
    display: inline-flex;
    overflow: hidden;
    width: 16px;
    height: 16px;
  }

  .notice-banner-wrapper .notice-banner-cta-arrow svg {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    animation: ffsNoticeArrowLoop 4s ease-in-out infinite;
  }

  .notice-banner-wrapper .notice-banner:hover .notice-banner-cta,
  .notice-banner-wrapper .notice-banner:focus-within .notice-banner-cta {
    background: linear-gradient(135deg, #9451c2, #7433a4) !important;
    color: #fff !important;
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 0 0 4px rgba(102, 45, 144, 0.2), 0 11px 24px rgba(48, 25, 60, 0.34);
  }

  @keyframes ffsNoticeSweep {
    0%, 24% { left: -32%; opacity: 0; }
    34% { opacity: 1; }
    62%, 100% { left: 128%; opacity: 0; }
  }

  @keyframes ffsNoticeCtaPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(102, 45, 144, 0.42), 0 8px 20px rgba(48, 25, 60, 0.3); }
    50% { box-shadow: 0 0 0 5px rgba(102, 45, 144, 0), 0 8px 20px rgba(48, 25, 60, 0.3); }
  }

  @keyframes ffsNoticeArrowLoop {
    0%, 64% { opacity: 1; transform: translateX(0); }
    72% { opacity: 0; transform: translateX(135%); }
    73% { opacity: 0; transform: translateX(-135%); }
    82%, 100% { opacity: 1; transform: translateX(0); }
  }

  @keyframes ffsNoticeMessageIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (min-width: 1024px) {
    .notice-banner-wrapper .notice-banner-shell,
    .notice-banner-wrapper .notice-banner {
      border-radius: 12px;
    }

    .notice-banner-wrapper .notice-banner {
      min-height: 104px;
      border: 1px solid rgba(102, 45, 144, 0.18);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.72),
        0 13px 34px rgba(63, 32, 79, 0.14);
    }

    .notice-banner-wrapper .notice-banner-content {
      padding: 20px 28px;
    }

    .notice-banner-wrapper .notice-banner-main {
      flex-direction: row;
      gap: 18px;
    }

    .notice-banner-wrapper .notice-banner-kicker {
      display: inline-flex;
      padding: 5px 13px 5px 6px;
      border-radius: 14px;
      font-size: 11px;
    }

    .notice-banner-wrapper .notice-banner-mascot {
      width: 26px;
      height: 26px;
      flex-basis: 26px;
      border-radius: 7px;
    }

    .notice-banner-wrapper .notice-banner-mascot img {
      height: 39.68px;
    }

    .notice-banner-wrapper .notice-banner-message {
      flex: 1 1 auto;
      max-width: 850px;
      font-size: clamp(19px, 1.9vw, 28px);
    }

    .notice-banner-wrapper .notice-banner-cta {
      min-height: 42px;
      padding: 11px 19px;
      font-size: 13px;
    }

  }

  @media (max-width: 420px) {
    .notice-banner-wrapper .notice-banner-message {
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notice-banner-wrapper .notice-banner::before,
    .notice-banner-wrapper .notice-banner-cta,
    .notice-banner-wrapper .notice-banner-cta-arrow svg,
    .notice-banner-wrapper .notice-banner-message.is-message-ready {
      animation: none;
    }

    .notice-banner-wrapper .notice-banner-cta {
      transition: none;
    }
  }
</style>

<script>
// Choose in the browser so full-page Varnish caching does not freeze one message.
// The global per-page selection keeps the separate mobile and desktop banners in sync.
(function() {
  const messages = ["Make Smarter FPL Decisions with Industry-Leading Points Projections","Win Your Mini-Leagues with Expert Strategy and Chip Guides","Nail Your Captaincy Picks with the Elite Captaincy Matrix","Master Your Transfers with AI-Powered Recommendations","Learn from the Best with 400+ Exclusive Expert Articles"];
  const noticeKey = 'ffs_notice_chief_scout_benefits_2026_v1';
  if (!Array.isArray(messages) || !messages.length) return;

  window.FFS = window.FFS || {};
  window.FFS.noticeMessageSelections = window.FFS.noticeMessageSelections || {};

  let selectedMessage = window.FFS.noticeMessageSelections[noticeKey];
  if (messages.indexOf(selectedMessage) === -1) {
    selectedMessage = messages[Math.floor(Math.random() * messages.length)];
    window.FFS.noticeMessageSelections[noticeKey] = selectedMessage;
  }

  document.querySelectorAll('.notice-banner-message').forEach(function(element) {
    if (element.getAttribute('data-notice-key') !== noticeKey) return;
    element.textContent = selectedMessage;
    if (!element.classList.contains('is-message-ready')) {
      element.classList.add('is-message-ready');
    }
  });
})();

</script>

