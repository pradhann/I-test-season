dLines":3,"showMoreCommand":{"clickTrackingParams":"CL8BEM2rARgBIhMI5PT66POrlgMVbJKKBx2RMSBuygEEXADMyQ==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CL8BEM2rARgBIhMI5PT66POrlgMVbJKKBx2RMSBuygEEXADMyQ==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CL8BEM2rARgBIhMI5PT66POrlgMVbJKKBx2RMSBuygEEXADMyQ==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CL8BEM2rARgBIhMI5PT66POrlgMVbJKKBx2RMSBuygEEXADMyQ==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"WOW - what an end to a dramatic weekend, and with Spurs still to play Leeds on Monday night, it's Arsenal who take a massive step towards the title and it's West Ham licking their wounds from a tough-to-take VAR call at the death. \n\n\nA Double Gameweek in name only for Lee and Sam, as neither went with any Palace players for their two games in GW36. Both went all-in on City though, with mixed success. Elsewhere Liverpool and Chelsea play out a draw at Anfield, Brighton smash Wolves and Bournemouth continue their push for European football with a decent 0-1 away win at Fulham. We talk through our scores, rank updates and differentials for that final push in GWs 37-38.\n\n\nA massive THANK YOU for all your support watching, liking and sharing our videos!\n\n\n__________________________\n 🚀 Support FPL Family on Patreon:\n\n\n     \n     \n  •  \n     \n     Exclusive FREE Podcasts every week looking ahead to the next GW\n     \n     \n     \n  •  \n     \n     Manager of the Month Competitions  - MONTHLY PRIZES!\n     \n     \n     \n  •  \n     \n     Zoom Video Chats with Lee and Sam\n     \n     \n     \n  •  \n     \n     Slack Chat community with other FPL Ma