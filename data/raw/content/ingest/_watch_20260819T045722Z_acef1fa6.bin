"startIndex":1892,"length":2,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1894,"length":40,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1934,"length":110,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2044,"length":27,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2071,"length":2,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2073,"length":40,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2113,"length":7,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2120,"length":40,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2160,"length":18,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2178,"length":40,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2218,"length":3,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2221,"length":32,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2253,"length":2,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2255,"length":40,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2295,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293982463,"raisedBackground":4293982463,"additiveBackground":556633057,"textPrimary":4278395197,"textSecondary":4279392150,"invertedBackground":4279392150,"overlayBackground":3422757181},"darkThemeColorPalette":{"baseBackground":4278259742,"raisedBackground":4278395197,"additiveBackground":724405217,"textPrimary":4292734717,"textSecondary":4287940340,"invertedBackground":4285707245,"overlayBackground":3422757181},"colorSampledDescriptionBodyText":{"content":"WOW - what an end to a dramatic weekend, and with Spurs still to play Leeds on Monday night, it's Arsenal who take a massive step towards the title and it's West Ham licking their wounds from a tough-to-take VAR call at the death. \n\n\nA Double Gameweek in name only for Lee and Sam, as neither went with any Palace players for their two games in GW36. Both went all-in on City though, with mixed success. Elsewhere Liverpool and Chelsea play out a draw at Anfield, Brighton smash Wolves and Bournemouth continue their push for European football with a decent 0-1 away win at Fulham. We talk through our scores, rank updates and differentials for that final push in GWs 37-38.\n\n\nA massive THANK YOU for all your support watching, liking and sharing our videos!\n\n\n__________________________\n 🚀 Support FPL Family on Patreon:\n\n\n     \n     \n  •  \n     \n     Exclusive FREE Podcasts every week looking ahead to the next GW\n     \n     \n     \n  •  \n     \n     Manager of the Month Competitions  - MONTHLY PRIZES!\n     \n     \n     \n  •  \n     \n     Zoom Video Chats with Lee and Sam\n     \n     \n     \n  •  \n     \n     Slack Chat community with other FPL Managers\n     \n     \n     \n\nJoin for FREE or Support the Channel!\n  (https://www.youtube.com/redirect?even...)  / fplfamily   (https://www.youtube.com/redirect?even...) \n________________________\n 📊 Join the FPLFamily FPL Mini-League!\n5162cw\n________________________\n🎧 Also available as a Podcast on your favourite Podcast platforms!\n  (https://www.youtube.com/redirect?even...)  / fplfamily   (https://www.youtube.com/redirect?even...) \nhttps://audioboom.com/channels/5010221 (https://www.youtube.com/redirect?even...) \nSearch 'FPL Family' on Spotify, Apple iTunes,  Deezer.\n __________________________\nStats, Season Tickers and Player Ratings provided by Fantasy Football Scout Members Area.\nBecome a member here! - http://Bit.ly/FFScoutFamily (https://www.youtube.com/redirect?even...) \n__________________________   \n 🏃‍♂️ Follow us on Twitter, Instagram and TikTok! - Just Search 'fplfamily'\nhttps://www.x.com/fplfamily (https://www.youtube.com/redirect?even...)  \n  (https://www.youtube.com/redirect?even...)  / fplfamily   (https://www.youtube.com/redirect?even...) \nhttps://www.tiktok.com/fplfamily (https://www.youtube.com/redirect?even....","commandRuns":[{"startIndex":1215,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwjk9Pro86uWAxVskooHHZExIG5I7J-Mgrfs7Ix_ygEEXADMyQ==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbTIxOWlGdUlnR00yZ1FkU1g3N0pkR2dpWEl5d3xBQ3Jtc0trbS0xb3dwODd2b0UtLTJmUkttb1dkVEV5cVEyVjYxRGktcUNyWVc5aW5aRUlSRFFqZ21SX082TUp5LXJsbjVZR25kLWlRUk16ekdmcGhkeHI1NTV3NW5uVVB1cDdCYjBKbDhjUFJkUmtvM21RNEE0UQ\u0026q=https%3A%2F%2Fwww.patreon.com%2Ffplfamily\u0026v=fYz5e3oix0s","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbTIxOWlGdUlnR00yZ1FkU1g3N0pkR2dpWEl5d3xBQ3Jtc0trbS0xb3dwODd2b0UtLTJmUkttb1dkVEV5cVEyVjYxRGktcUNyWVc5aW5aRUlSRFFqZ21SX082TUp5LXJsbjVZR25kLWlRUk16ekdmcGhkeHI1NTV3NW5uVVB1cDdCYjBKbDhjUFJkUmtvM21RNEE0UQ\u0026q=https%3A%2F%2Fwww.patreon.com%2Ffplfamily\u0026v=fYz5e3oix0s","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":1273,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwjk9Pro86uWAxVskooHHZExIG5I7J-Mgrfs7Ix_ygEEXADMyQ==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbTIxOWlGdUlnR00yZ1FkU1g3N0pkR2dpWEl5d3xBQ3Jtc0trbS0xb3dwODd2b0UtLTJmUkttb1dkVEV5cVEyVjYxRGktcUNyWVc5aW5aRUlSRFFqZ21SX082TUp5LXJsbjVZR25kLWlRUk16ekdmcGhkeHI1NTV3NW5uVVB1cDdCYjBKbDhjUFJkUmtvM21RNEE0UQ\u0026q=https%3A%2F%2Fwww.patreon.com%2Ffplfamily\u0026v=fYz5e3oix0s","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url"