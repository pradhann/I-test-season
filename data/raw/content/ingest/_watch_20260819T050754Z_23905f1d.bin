gers for daily discussion, banter and insight.\n\n🟢 Tools to help your season – FPL Stats, TransferLab and Team Ratings, all built to help you make sharper decisions week to week.\n\n🟢 Competitions with physical prizes – FPL League, Predictions League, Goalscorer Challenge and Survivor, all with real trophies and bragging rights on the line.\n\nIf you're serious about your FPL season this year, this is everything you need in one place.\n\n----------------------------------------------\n#FPL #FantasyPremierLeague #PremierLeague","commandRuns":[{"startIndex":792,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CMgBENzXBBgGIhMIjfXdlvarlgMVYMGVAh3pPSrRygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fpl","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUHCgNmcGwYAQ%3D%3D"}}},"loggingDirectives":{"trackingParams":"CMgBENzXBBgGIhMIjfXdlvarlgMVYMGVAh3pPSrR"}},{"startIndex":797,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CMcBENzXBBgHIhMIjfXdlvarlgMVYMGVAh3pPSrRygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fantasypremierleague","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUYChRmYW50YXN5cHJlbWllcmxlYWd1ZRgB"}}},"loggingDirectives":{"trackingParams":"CMcBENzXBBgHIhMIjfXdlvarlgMVYMGVAh3pPSrR"}},{"startIndex":819,"length":14,"onTap":{"innertubeCommand":{"clickTrackingParams":"CMYBENzXBBgIIhMIjfXdlvarlgMVYMGVAh3pPSrRygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/premierleague","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gURCg1wcmVtaWVybGVhZ3VlGAE%3D"}}},"loggingDirectives":{"trackingParams":"CMYBENzXBBgIIhMIjfXdlvarlgMVYMGVAh3pPSrR"}}],"styleRuns":[{"startIndex":0,"length":792,"styleRunExtensions":{"styleRunCo