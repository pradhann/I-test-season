.harry@gmail.com\n___________\n⏱️ Timestamps\n0:00 Intro\n0:31 Most Picked Players\n3:22 Chip Strategy\n4:45 Squad Structure\n5:42 Captaincy\n6:54 GK + Defenders\n9:22 MIDs + FWDs\n10:13 World No.31 Team!\n14:56 World No.256 Team!\n17:33 World No.172 Team!\n18:51 BB1 No Haaland!\n19:45  BB1 Team\n20:30 World No.118 Team!\n21:32 BB2 Team\n22:12 World No.46 Team!\n23:44 50x Top 1K Template\n25:20 Outro\n___________\n\n#fpl  #fantasypremierleague  #premierleague #gw1","commandRuns":[{"startIndex":46,"length":27,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBcQ040EGAciEwibsdeG9quWAxU_lcsBHUXrAOBI05ePx-vQ74p0ygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUnM3QzFLMUFZM2QyaklPdWc1NkVZMXxBR3JiS2FsbEdnSzVIR2dRNlZQdHlQZUNOSHB2aEpUckxiX1hSMWN1Ym5HX3ExaW41ajd4c290TGVFZmpQaEVsVWc2Q2hva3pLaGt4YlkyZDVwWnExZUduR21sRjBDbmlRckM4\u0026q=https%3A%2F%2Fbit.ly%2FFFScoutHarry\u0026v=dBW-hrjjy9M","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUnM3QzFLMUFZM2QyaklPdWc1NkVZMXxBR3JiS2FsbEdnSzVIR2dRNlZQdHlQZUNOSHB2aEpUckxiX1hSMWN1Ym5HX3ExaW41ajd4c290TGVFZmpQaEVsVWc2Q2hva3pLaGt4YlkyZDVwWnExZUduR21sRjBDbmlRckM4\u0026q=https%3A%2F%2Fbit.ly%2FFFScoutHarry\u0026v=dBW-hrjjy9M","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":237,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBcQ040EGAciEwibsdeG9quWAxU_lcsBHUXrAOBI05ePx-vQ74p0ygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rU1pnRWFmbEcxR2xOTURmakVWc2VEQXxBR3JiS2FsMWFpNXBhVlpidlMtZFU3Y1FxNUFOSHltclN0ZVM1TXUxeG5uVUF6NkJIS0NhTC1veXAyUFhHS09vTVdEQXBXOVVGVWR1U0xIYUtoeDZLRWlVOW1FVmkxUjJsa2VG\u0026q=https%3A%2F%2Ffantasy.premierleague.com%2Fleagues%2Fauto-join%2Fa6fgym\u0026v=dBW-hrjjy9M","webPageType":"WEB_PAGE_TYPE_UNKN