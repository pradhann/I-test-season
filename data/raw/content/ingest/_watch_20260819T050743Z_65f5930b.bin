47,"length":68,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1715,"length":51,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1766,"length":66,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1832,"length":51,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1883,"length":70,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1953,"length":51,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2004,"length":43,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2047,"length":32,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2079,"length":75,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2154,"length":17,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2171,"length":62,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2233,"length":51,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2284,"length":65,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2349,"length":51,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2400,"length":2,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2402,"length":21,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2423,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2424,"length":4,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2428,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2429,"length":9,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964720,"raisedBackground":4294964720,"additiveBackground":566850373,"textPrimary":4281735434,"textSecondary":4285614903,"invertedBackground":4287578649,"overlayBackground":3426097418},"darkThemeColorPalette":{"baseBackground":4280027906,"raisedBackground":4281735434,"additiveBackground":734622533,"textPrimary":4294633952,"textSecondary":4292852906,"invertedBackground":4293107580,"overlayBackground":3426097418},"colorSampledDescriptionBodyText":{"content":"On the opening Podcast of the final day of Correspondent Week James is joined by Coventry fan Andrew O'Gorman to discuss all things about The Championship Winners ahead of next Friday's opener at Arsenal.\n\nBut it's the following week that will have FPL managers particularly interested, A Bench Boost GW2 strategy heavily involves a play to get the right Coventry assets for their game against Hull.\n\nAll the 4.0 defenders assessed, new signings covered, and there may be some 5.0 forwards starting the season. The right options are identified, but for some there are warnings too.\n\n---------------------------------------------------------------------------------\nIntro: 0:00\nLampard \u0026 Tactics: 1:26\nFixtures: 4:18\nHamer: 6:02\nOther New Signings: 9:55\nWill there be more?: 16:34\nForwards: 17:34\nGoalkeepers: 22:32\nDefenders: 25:49\nGW2 v Hull: 30:42\n5.5 MIDs: 41:34\n5.0 MIDs: 42:53 \nPredicted Team GW 1 \u0026 2: 44:45\nSeason Expectations: 46:18\n----------------------------------------------------------------------------------\n\nNext on Correspondent Week: ep. 18 with Simon Bibby on Newcastle\n\nAnd later on Planet FPL: Correspondent Week episodes 19 \u0026 20 with Lauren Harris on Liverpool and Sean Norton on Everton\n\nAnd on Patreon: The Debrief with Suj and James on today's four Podcasts (IT+) and After The Podcast with today's Correspondents (AT)\n\nThe full schedule for Correspondent Week can be found here: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / correspondent-166192123⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  \n\nWant to become a member of our FPL community and support the Podcast? \n\nJoin us on Patreon: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow James on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfplpod⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Suj on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / sujanshah⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Clayton on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / claytsafc⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Nico on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / nico_semedo⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  \n\nSubscribe to our YouTube channel: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠   / @planetfpl  \n\nLike us on Facebook: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow us on Instagram: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\n#FantasyPremierLeague #FPL #Coventry","commandRuns":[{"startIndex":672,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwju2baR9quWAxWMlIoHHaSjGjLKAQQIZ7zi","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=9mjFuZGccD4","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"9mjFuZGccD4","continuePlayback":true,"startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr5---sn-a5msen76.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026olis=1\u0026ofpcc=1\u0026msp=1\u0026odepv=1\u0026id=f668c5b9919c703e\u0026ip=68.255.249.182\u0026initcwndbps=2326250\u0026mt=1787115684\u0026oweuc="}}}}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"0 seconds"}}},{"startIndex":696,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwju2baR9quWAxWMlIoHHaSjGjLKAQQIZ7zi","commandMetadata":{"webCommandMetadata":{"url":