m2kfarlgMVjJSKBx2koxoyygEECGe84g==","openPopupAction":{"popup":{"confirmDialogRenderer":{"trackingParams":"CJ8CEMY4IhMI7tm2kfarlgMVjJSKBx2koxoy","dialogMessages":[{"runs":[{"text":"Unsubscribe from "},{"text":"Planet FPL"},{"text":"?"}]}],"confirmButton":{"buttonRenderer":{"style":"STYLE_BLUE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"Unsubscribe"}]},"serviceEndpoint":{"clickTrackingParams":"CKECEPBbIhMI7tm2kfarlgMVjJSKBx2koxoyKPgdMgV3YXRjaMoBBAhnvOI=","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/unsubscribe"}},"unsubscribeEndpoint":{"channelIds":["UC8043oOKTB4uP8Nq15Kz6bg"],"params":"CgIIAxILOW1qRnVaR2NjRDQYAA%3D%3D"}},"accessibility":{"label":"Unsubscribe"},"trackingParams":"CKECEPBbIhMI7tm2kfarlgMVjJSKBx2koxoy"}},"cancelButton":{"buttonRenderer":{"style":"STYLE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"Cancel"}]},"accessibility":{"label":"Cancel"},"trackingParams":"CKACEPBbIhMI7tm2kfarlgMVjJSKBx2koxoy"}},"primaryIsCancel":false}},"popupType":"DIALOG"}}]}}]}},"metadataRowContainer":{"metadataRowContainerRenderer":{"collapsedItemCount":0,"trackingParams":"CJoCEM2rARgBIhMI7tm2kfarlgMVjJSKBx2koxoy"}},"showMoreText":{"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"trackingParams":"CJoCEM2rARgBIhMI7tm2kfarlgMVjJSKBx2koxoy","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CJoCEM2rARgBIhMI7tm2kfarlgMVjJSKBx2koxoyygEECGe84g==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CJoCEM2rARgBIhMI7tm2kfarlgMVjJSKBx2koxoyygEECGe84g==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CJoCEM2rARgBIhMI7tm2kfarlgMVjJSKBx2koxoyygEECGe84g==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CJoCEM2rARgBIhMI7tm2kfarlgMVjJSKBx2koxoyygEECGe84g==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"On the opening Podcast of the final day of Correspondent Week James is joined by Coventry fan Andrew O'Gorman to discuss all things about The Championship Winners ahead of next Friday's opener at Arsenal.\n\nBut it's the following week that will have FPL managers particularly interested, A Bench Boost GW2 strategy heavily involves a play to get the right Coventry assets for their game against Hull.\n\nAll the 4.0 defenders assessed, new signings covered, and there may be some 5.0 forwards starting the season. The right options are identified, but for some there are warnings too.\n\n---------------------------------------------------------------------------------\nIntro: 0:00\nLampard \u0026 Tactics: 1:26\nFixtures: 4:18\nHamer: 6:02\nOther New Signings: 9:55\nWill there be more?: 16:34\nForwards: 17:34\nGoalkeepers: 22:32\nDefenders: 25:49\nGW2 v Hull: 30:42\n5.5 MIDs: 41:34\n5.0 MIDs: 42:53 \nPredicted Team GW 1 \u0026 2: 44:45\nSeason Expectations: 46:18\n----------------------------------------------------------------------------------\n\nNext on Correspondent Week: ep. 18 with Simon Bibby on Newcastle\n\nAnd later on Planet FPL: Correspondent Week episodes 19 \u0026 20 with Lauren Harris on Liverpool and Sean Norton on Everton\n\nAnd on Patreon: The Debrief with Suj and James on today's four Podcasts (IT+) and After The Podcast with today's Correspondents (AT)\n\nThe full schedule for Correspondent Week can be found here: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / correspondent-166192123⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  \n\nWant to become a member of our FPL community and support the Podcast? \n\nJoin us on Patreon: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow James on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfplpod⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Suj on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / sujanshah⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Clayton on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / claytsafc⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Nico on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / nico_semedo⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  \n\nSubscribe to our YouTube channel: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠   / @planetfpl  \n\nLike us on Facebook: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow us on Instagram: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\n#FantasyPremierLeague #FPL #Coventry","commandRuns":[{"startIndex":672,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CJoCEM2rARgBIhMI7tm2kfarlgMVjJSKBx2koxoyygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=9mjFuZGccD4","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"9mjFuZGccD4","continuePlayback":true,"startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr5---sn-a5msen76.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026olis=1\u0026ofpcc=1\u0026msp=1\u0026odepv=1\u0026id=f668c5b9919c703e\u0026ip=68.255.249.182\u0026initcwndbps=2326250\u0026mt=1787115684\u0026oweuc="}}}}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"0 seconds"}}},{"startIndex":696,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CJoCEM2rARgBIhMI7tm2kfarlgMVjJSKBx2koxoyygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=9mjFuZGccD4\u0026t=86s","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"9mjFuZGccD4","continuePlayback":true,"startTimeSeconds":86,"watchEndpointSupportedOnesieConfig":{"h