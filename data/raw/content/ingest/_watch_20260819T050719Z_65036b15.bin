ue":2569099647},{"key":"880000","value":2569295999},{"key":"890000","value":2572358527},{"key":"900000","value":2568904575},{"key":"910000","value":2569491327},{"key":"920000","value":2571115135},{"key":"930000","value":2569100415},{"key":"940000","value":2569620863},{"key":"950000","value":2569035135},{"key":"960000","value":2569557887},{"key":"970000","value":2570272639},{"key":"980000","value":2571115135},{"key":"990000","value":2571115647},{"key":"1000000","value":2568969343},{"key":"1010000","value":2568576895},{"key":"1020000","value":2568903807},{"key":"1030000","value":2569099903},{"key":"1040000","value":2569165695},{"key":"1050000","value":2569427071},{"key":"1060000","value":2569621887},{"key":"1070000","value":2571246719},{"key":"1080000","value":2569100159},{"key":"1090000","value":2569230207},{"key":"1100000","value":2571377023},{"key":"1110000","value":2571965311},{"key":"1120000","value":2569295487},{"key":"1130000","value":2569035135},{"key":"1140000","value":2569230975},{"key":"1150000","value":2569426559},{"key":"1160000","value":2571244671},{"key":"1170000","value":2571507071},{"key":"1180000","value":2569165183},{"key":"1190000","value":2571244671},{"key":"1200000","value":2571572095},{"key":"1210000","value":2569230463},{"key":"1220000","value":2568969599},{"key":"1230000","value":2569231231},{"key":"1240000","value":2569492095},{"key":"1250000","value":2570013311},{"key":"1260000","value":2570918271},{"key":"1270000","value":2568837503},{"key":"1280000","value":2571377535},{"key":"1290000","value":2568968319},{"key":"1300000","value":2569229183},{"key":"1310000","value":2569490815},{"key":"1320000","value":2569686399},{"key":"1330000","value":2570142847},{"key":"1340000","value":2571113599},{"key":"1350000","value":2571375487},{"key":"1360000","value":2568903295},{"key":"1370000","value":2568576383},{"key":"1380000","value":2568838015},{"key":"1390000","value":2569033343},{"key":"1400000","value":2569099647},{"key":"1410000","value":2569426559},{"key":"1420000","value":2569621119},{"key":"1430000","value":2572292991},{"key":"1440000","value":2573079423},{"key":"1450000","value":2568838783},{"key":"1460000","value":2571179647},{"key":"1470000","value":2572096383},{"key":"1480000","value":2569296767},{"key":"1490000","value":2569492351}]}}}],"microformat":{"microformatDataRenderer":{"videoDetails":{"comments":[{"type":"https://schema.org/Comment","dateCreated":"2026-08-16T02:26:44-07:00","text":"Thx Harry, Schade is such a good shout!  I was at the Gtech yesterday, checking out Sangare, Ajer and Thiago.  Schade is sharp and certainly ahead of Anthony right now (cant believe I actually forgotten him; something to seriously consider in my no Haaland BB1 draft, especially he has great fixture in my potential weakest GW3, and more affordable than Thiago, since I already have Isak - my GW3 captain, and Pedro must have for GW4).  I try not to be biased but as the Bees supporter I plan to attend more games this season, coz we finally feel like a proper UEFA level side now.  Sangare is more box-to-box than defensive midfielder, and has this classy touch/control like Toney/Wissa, and already in a position to one touch pass or dribble before he receive the ball -  think he will proved to be the difference in our midfield when there would be less time and space in the actual competitive games (his attacking threat on open play + defcon should outscore Gross's occasional set-piece with minutes risk)","author":{"type":"https://schema.org/Person","name":"@repentmaster2842","url":"https://www.youtube.com/@repentmaster2842","alternateName":"Repent Master"},"upvoteCount":25}]}}},"frameworkUpdates":{"entityBatchUpdate":{"mutations":[{"entityKey":"EgZ0b3BiYXIg9QEoAQ%3D%3D","type":"ENTITY_MUTATION_TYPE_DELETE","options":{"persistenceOption":"ENTITY_PERSISTENCE_OPTION_INMEMORY_AND_PERSIST"}},{"entityKey":"EhxsaWtlX2J1dHRvbl9hbmltYXRpb25fZW50aXR5ILcEKAE%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"likeButtonAnimationEn