allhub  \n🐦 Jack's Twitter:   / redditoryt  \n🐦 Will's Twitter:   / ffh_will  \n🐦 Edited By Stevo:   / editor_stevo  \n━━━━━━━━━━━━━\nABOUT 💭\nFantasy Football Hub brings you the very best Fantasy Premier League tools, players, writers, bloggers and content creators under one roof. If you're looking for fantasy football advice, we are the channel for you.\n\n#FPL #FantasyPremierLeague #PremierLeague","commandRuns":[{"startIndex":36,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwj09qTt86uWAxVkR_IAHeTBGppI9MyrsLCDg8jnAcoBBFwAzMk=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rU2dYZndtY05ZN2JhaWp0TWo1Z0N2MXxBR3JiS2FtQTV0bUlwSDlTdzVDQ2ZhdlFLRGNoNGFfWTExdHR5Q19vOEZENlZCNWhTTkpyWkN3LU5rZ2dTY1puMk9PamwwX250SlIybjhacUs2R19oN0xWMVZjR2NDY2hqWFh2\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Fai-team-rating%3Futm_source%3Dyoutube%26utm_medium%3Dhubyoutube%26utm_campaign%3Djack26%26via%3Djack26\u0026v=55AMGwYK5nQ","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rU2dYZndtY05ZN2JhaWp0TWo1Z0N2MXxBR3JiS2FtQTV0bUlwSDlTdzVDQ2ZhdlFLRGNoNGFfWTExdHR5Q19vOEZENlZCNWhTTkpyWkN3LU5rZ2dTY1puMk9PamwwX250SlIybjhacUs2R19oN0xWMVZjR2NDY2hqWFh2\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Fai-team-rating%3Futm_source%3Dyoutube%26utm_medium%3Dhubyoutube%26utm_campaign%3Djack26%26via%3Djack26\u0026v=55AMGwYK5nQ","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":239,"length":5,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwj09qTt86uWAxVkR_IAHeTBGprKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=55AMGwYK5nQ","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"55AMGwYK5nQ","continuePlayback":true,"startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfi