 We will do our best to answer these at the end of the stream\n----------------------------------------------\nFollow us:\n\n🅾 INSTAGRAM: www.instagram.com/FPLBlackBox\n\n💻 DISCORD:     / discord  \n\n🐦X: https://www.x.com/fplblackbox\n-----------------------------------------------\n#FPLBlackBox #FPL #FantasyPremierLeague #premierleague #GW1 Fantasy Football Scout, Fantasy Football Tips, Fantasy Football Gameweek 1 GW 1\n-----------------------------------------------\nContact us: \n\n📧 Az@fplblackbox.com\n📧 Andy@fplblackbox.com","commandRuns":[{"startIndex":412,"length":30,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwj__qrs86uWAxUvoAoIHYO1A8BIuuXww4KV9-ZZygEEXADMyQ==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUm5GajhGV2lXbmdkM01lU0R2NG5MX3xBR3JiS2FtNW5QTExvclpMMlZFeXR5QlZrV2x0TW5xbXQ5VlJRMTEzVXFjeVZ1Y2I2UGl4X3lHeDFTX3N4RHpwQkxqOVNOaHlmUWROVk5vSVM5UGRkSDB2dFJoRnBPbG8wTGtZ\u0026q=https%3A%2F%2Fbit.ly%2FFFScoutBlackBox\u0026v=Wc3cqCh8Mro","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUm5GajhGV2lXbmdkM01lU0R2NG5MX3xBR3JiS2FtNW5QTExvclpMMlZFeXR5QlZrV2x0TW5xbXQ5VlJRMTEzVXFjeVZ1Y2I2UGl4X3lHeDFTX3N4RHpwQkxqOVNOaHlmUWROVk5vSVM5UGRkSDB2dFJoRnBPbG8wTGtZ\u0026q=https%3A%2F%2Fbit.ly%2FFFScoutBlackBox\u0026v=Wc3cqCh8Mro","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":697,"length":22,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwj__qrs86uWAxUvoAoIHYO1A8BIuuXww4KV9-ZZygEEXADMyQ==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rU2R3OU93MmZlQ0FwQTlTOXRNRWxZbXxBR3JiS2FsbDZ5SFpxdklIR0JvUGNxT0hMRk1yQTBxOG94SWdVNVRad1JiQXMtRzdTaFZlX21YUWlHOEVPc3o4bUNPZEV5U2NRM1E5TUpGLVU4ZjFKMS1Cc0FwSkhQMUtmYW9n\u0026q=https%3A%2F%2Fbit.ly%2F3jwrN96\u0026v=Wc3cqCh8Mro"