On4CLD0NFtnjxr4DfF4JfhTTVwi7ziLRA","recommendedLevel":3,"fineScrubbingRecommendedLevel":2,"highResolutionRecommendedLevel":3}},"microformat":{"playerMicroformatRenderer":{"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/3O8rsWchEM0/maxresdefault.jpg","width":1280,"height":720}]},"embed":{"iframeUrl":"https://www.youtube.com/embed/3O8rsWchEM0","width":1280,"height":720},"title":{"simpleText":"Tell Me Why I’m Wrong Before Gameweek 1 😬"},"description":{"simpleText":"Gillette are campaigning to bring back the iconic shirt off celebration and I support it. Click the link here https://www.gillette.co.uk/c/shirt-off-celebration-petition/  to sign the petition! #ad\n━━━━━━━━━━━━━\nWhat am I wrong about in FPL? Let's talk about it.\n\nLast seasons rank = 588th!\n\nBest 5 ranks = 588, 1294, 4935, 8492, 9975.\n━━━━━━━━━━━━━\n🙏 Subscribe: https://bit.ly/SubLTFPL\n👍 Follow me: https://linktr.ee/letstalkfpl\n💪 Become a channel member: https://bit.ly/LTFPLYTMember\n📩 Business Inquiries: andy@letstalkfpl.com \n━━━━━━━━━━━━━\nJoin my league 👉 glojzb\n━━━━━━━━━━━━━\n00:00 Intro\n00:18 Szoboszlai\n07:25 Calvert-Lewin\n11:20 Not enough hype about Saka\n13:39 Not valuing DEFCON\n18:14 Not really considering Gabriel\n21:26 Van Dijk is being overlooked\n23:38 Pushing early Bench Boost too much\n29:10 You're overrating Pascal Groß\n31:01 Not thinking about Sangaré enough\n33:18 Overrating Harry Maguire\n35:15 Not giving Isak enough thought\n━━━━━━━━━━━━━\n#FPL #FantasyPremierLeague #PremierLeague"},"lengthSeconds":"2265","ownerProfileUrl":"http://www.youtube.com/@LetsTalkFPL","externalChannelId":"UCxeOc7eFxq37yW_Nc-69deA","isFamilySafe":true,"availableCountries":["AD","AE","AF","AG","AI","AL","AM","AO","AQ","AR","AS","AT","AU","AW","AX","AZ","BA","BB","BD","BE","BF","BG","BH","BI","BJ","BL","BM","BN","BO","BQ","BR","BS","BT","BV","BW","BY","BZ","CA","CC","CD","CF","CG","CH","CI","CK","CL","CM","CN","CO","CR","CU","CV","CW","CX","CY","CZ","DE","DJ","DK","DM","DO","DZ","EC","EE","EG