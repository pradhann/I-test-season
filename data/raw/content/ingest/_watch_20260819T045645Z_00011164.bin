dText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"Aug 14"},"label":{"simpleText":"2026"},"accessibilityText":"Aug 14, 2026","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293984255,"raisedBackground":4293984255,"additiveBackground":556654561,"textPrimary":4278402109,"textSecondary":4279408022,"invertedBackground":4279205503,"overlayBackground":3422764093},"darkThemeColorPalette":{"baseBackground":4278263326,"raisedBackground":4278402109,"additiveBackground":724426721,"textPrimary":4292738557,"textSecondary":4287951860,"invertedBackground":4285721837,"overlayBackground":3422764093},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAciEwjiptTX86uWAxXcAtsBHeduLdfKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/@LetsTalkFPL","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCxeOc7eFxq37yW_Nc-69deA","canonicalBaseUrl":"/@LetsTalkFPL"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/5z1cxn9gvqu-SW_xfdTX2_yYJyHrVfyu5CzCIwvs1WaGATxozrYEWi6uUlXvyEjfL3Xf2aGZ=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Gillette are campaigning to bring back the iconic shirt off celebration and I support it. Click the link here https://www.gillette.co.uk/c/shirt-of...  to sign the petition! #ad\n━━━━━━━━━━━━━\nWhat am I wrong about in FPL? Let's talk about it.\n\nLast seasons rank = 588th!\n\nBest 5 ranks = 588, 1294, 4935, 8492, 9975.\n━━━━━━━━━━━━━\n🙏 Subscribe: https://bit.ly/SubLTFPL\n👍 Follow me: https://linktr.ee/letstalkfpl\n💪 Become a channel member: https://bit.ly/LTFPLYTMember\n📩 Business Inquiries: andy@letstalkfpl.com \n━━━━━━━━━━━━━\nJoin my league 👉 glojzb\n━━━━━━━━━━━━━\n00:00 Intro\n00:18 Szoboszlai\n07:25 Calvert-Lewin\n11:20 Not enough hype about Saka\n13:39 Not valuing DEFCON\n18:14 Not really considering Gabriel\n21:26 Van Dijk is being overlooked\n23:38 Pushing early Bench Boost too much\n29:10 You're overrating Pascal Groß\n31:01 Not thinking about Sangaré enough\n33:18 Overrating Harry Maguire\n35:15 Not giving Isak enough thought\n━━━━━━━━━━━━━\n#FPL #FantasyPremierLeague #PremierLeague","commandRuns":[{"startIndex":110,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwjiptTX86uWAxXcAtsBHeduLddIzaGEuZb2yvfcAcoBBFwAzMk=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUUUxbjNrVURuUE9vTXVBSkZmNG0xeXxBR3JiS2FsZ0hyaWpqUUp1LW8wM2pUVjRWczRnXzkxeDUxV0E2SGkwY0ktS256Z1VRcDZjSzRWNEdNSkMweG1TbG5wb2lkWFlDc1RTemtsMjZOd1Z2X0tobm1VdmNWQWtqQU5n\u0026q=https%3A%2F%2Fwww.gillette.co.uk%2Fc%2Fshirt-off-celebration-petition%2F\u0026v=3O8rsWchEM0","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUUUxbjNrVURuUE9vTXVBSkZmNG0xeXxBR3JiS2FsZ0hyaWpqUUp1LW8wM2pUVjRWczRnXzkxeDUxV0E2SGkwY0ktS256Z1VRcDZjSzRWNEdNSkMweG1TbG5wb2lkWFlDc1RTemtsMjZOd1Z2X0tobm1VdmNWQWtqQU5n\u0026q=https%3A%2F%2Fwww.gillette.co.uk%2Fc%2Fshirt-off-celebration-petition%2F\u0026v=3O8rsWchEM0","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":174,"length":3,"onTap":{"innertubeCommand":{"clickTrackingParams":"CDcQ3NcEGG0iEwjiptTX86uWAxXcAtsBHeduLdfKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/ad","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUGCgJhZBgB"}}},"loggingDirectives":{"trackingParams":"CDcQ3NcEGG0iEwjiptTX86uWAxXcAtsBHeduLdc="}},{"startIndex