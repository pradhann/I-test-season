y manage to agree on their FPL team?! 😂\n\nLet us know in the comments: WHO is your must-have FPL player for 2026/27? 👇\n\n#FPL #FantasyPremierLeague #FPL2026 #FPLTips #FPLFamily","commandRuns":[{"startIndex":694,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CM0BENzXBBgKIhMI26HukvarlgMVE5SKBx15QjpkygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fpl","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUHCgNmcGwYAQ%3D%3D"}}},"loggingDirectives":{"trackingParams":"CM0BENzXBBgKIhMI26HukvarlgMVE5SKBx15Qjpk"}},{"startIndex":699,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CMwBENzXBBgLIhMI26HukvarlgMVE5SKBx15QjpkygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fantasypremierleague","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUYChRmYW50YXN5cHJlbWllcmxlYWd1ZRgB"}}},"loggingDirectives":{"trackingParams":"CMwBENzXBBgLIhMI26HukvarlgMVE5SKBx15Qjpk"}},{"startIndex":721,"length":8,"onTap":{"innertubeCommand":{"clickTrackingParams":"CMsBENzXBBgMIhMI26HukvarlgMVE5SKBx15QjpkygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fpl2026","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gULCgdmcGwyMDI2GAE%3D"}}},"loggingDirectives":{"trackingParams":"CMsBENzXBBgMIhMI26HukvarlgMVE5SKBx15Qjpk"}},{"startIndex":730,"length":8,"onTap":{"innertubeCommand":{"clickTrackingParams":"CMoBENzXBBgNIhMI26HukvarlgMVE5SKBx15QjpkygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fpltips","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gULCgdmcGx0aXBzGAE%3D"}}},"loggingDirectives":{"trackingParams":"CMoBENzXBBgNIhMI26HukvarlgMVE5SKBx15Qjpk"}}