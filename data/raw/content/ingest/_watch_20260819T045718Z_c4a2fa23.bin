e":"uz","languageName":{"simpleText":"Uzbek"}},{"languageCode":"ve","languageName":{"simpleText":"Venda"}},{"languageCode":"vi","languageName":{"simpleText":"Vietnamese"}},{"languageCode":"war","languageName":{"simpleText":"Waray"}},{"languageCode":"cy","languageName":{"simpleText":"Welsh"}},{"languageCode":"fy","languageName":{"simpleText":"Western Frisian"}},{"languageCode":"wo","languageName":{"simpleText":"Wolof"}},{"languageCode":"xh","languageName":{"simpleText":"Xhosa"}},{"languageCode":"yi","languageName":{"simpleText":"Yiddish"}},{"languageCode":"yo","languageName":{"simpleText":"Yoruba"}},{"languageCode":"zu","languageName":{"simpleText":"Zulu"}}],"defaultAudioTrackIndex":0}},"videoDetails":{"videoId":"AV6VOinLy9c","title":"We Went to Brighton… and Built Our FPL Teams 👀 | FPL 2026/27","lengthSeconds":"1263","keywords":["fpl","fantasy","premier","league","football","soccer","fplfamily"],"channelId":"UCDG_EqOaaO1SSxEMZwfrSkg","isOwnerViewing":false,"shortDescription":"Pre-season FPL planning got a LOT more fun… 😅 Lee \u0026 Sam head down to Brighton to spend the weekend with our FPL friends Az from FPL BlackBox and Yelena — and, naturally, we ended up talking A LOT about Fantasy Premier League!\n\nIn this video, we’ve pulled together the best bits from the trip: FPL 2026/27 tips, player picks, team ideas and strategy for the new season, mixed with a behind-the-scenes vlog of what we got up to together in Brighton. 🌊⚽️\n\nWho are Az, Yelena, Lee and Sam backing for GW1? Which players are causing the biggest debates? And did anyone actually manage to agree on their FPL team?! 😂\n\nLet us know in the comments: WHO is your must-have FPL player for 2026/27? 👇\n\n#FPL #FantasyPremierLeague #FPL2026 #FPLTips #FPLFamily","isCrawlable":true,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/AV6VOinLy9c/hqdefault.jpg?sqp=-oaymwEiCKgBEF5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLBRENDlSWmfdvLAHA21Ykc8K7OMMw","width":168,"height":94},{"url":"https://