 anyone actually manage to agree on their FPL team?! 😂\n\nLet us know in the comments: WHO is your must-have FPL player for 2026/27? 👇\n\n#FPL #FantasyPremierLeague #FPL2026 #FPLTips #FPLFamily","commandRuns":[{"startIndex":694,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCwQ3NcEGB8iEwihooXn86uWAxUesIoHHZ7aJdjKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fpl","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUHCgNmcGwYAQ%3D%3D"}}},"loggingDirectives":{"trackingParams":"CCwQ3NcEGB8iEwihooXn86uWAxUesIoHHZ7aJdg="}},{"startIndex":699,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCsQ3NcEGCAiEwihooXn86uWAxUesIoHHZ7aJdjKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fantasypremierleague","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUYChRmYW50YXN5cHJlbWllcmxlYWd1ZRgB"}}},"loggingDirectives":{"trackingParams":"CCsQ3NcEGCAiEwihooXn86uWAxUesIoHHZ7aJdg="}},{"startIndex":721,"length":8,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCoQ3NcEGCEiEwihooXn86uWAxUesIoHHZ7aJdjKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fpl2026","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gULCgdmcGwyMDI2GAE%3D"}}},"loggingDirectives":{"trackingParams":"CCoQ3NcEGCEiEwihooXn86uWAxUesIoHHZ7aJdg="}},{"startIndex":730,"length":8,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCkQ3NcEGCIiEwihooXn86uWAxUesIoHHZ7aJdjKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fpltips","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gULCgdmcGx0aXBzGAE%3D"}}},"loggingDirectives":{"trackingParams":"CCkQ3NcEGCIiEwihooXn86uWAxUesIoHHZ7aJdg="}},