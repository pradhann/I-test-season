onfirmDialogRenderer":{"trackingParams":"CLkCEMY4IhMI77yS5POrlgMVsY-KBx0Epxs4","dialogMessages":[{"runs":[{"text":"Unsubscribe from "},{"text":"Planet FPL"},{"text":"?"}]}],"confirmButton":{"buttonRenderer":{"style":"STYLE_BLUE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"Unsubscribe"}]},"serviceEndpoint":{"clickTrackingParams":"CLsCEPBbIhMI77yS5POrlgMVsY-KBx0Epxs4KPgdMgV3YXRjaMoBBFwAzMk=","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/unsubscribe"}},"unsubscribeEndpoint":{"channelIds":["UC8043oOKTB4uP8Nq15Kz6bg"],"params":"CgIIAxILY0V5LVdOaEdFaE0YAA%3D%3D"}},"accessibility":{"label":"Unsubscribe"},"trackingParams":"CLsCEPBbIhMI77yS5POrlgMVsY-KBx0Epxs4"}},"cancelButton":{"buttonRenderer":{"style":"STYLE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"Cancel"}]},"accessibility":{"label":"Cancel"},"trackingParams":"CLoCEPBbIhMI77yS5POrlgMVsY-KBx0Epxs4"}},"primaryIsCancel":false}},"popupType":"DIALOG"}}]}}]}},"metadataRowContainer":{"metadataRowContainerRenderer":{"collapsedItemCount":0,"trackingParams":"CLQCEM2rARgBIhMI77yS5POrlgMVsY-KBx0Epxs4"}},"showMoreText":{"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"trackingParams":"CLQCEM2rARgBIhMI77yS5POrlgMVsY-KBx0Epxs4","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CLQCEM2rARgBIhMI77yS5POrlgMVsY-KBx0Epxs4ygEEXADMyQ==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CLQCEM2rARgBIhMI77yS5POrlgMVsY-KBx0Epxs4ygEEXADMyQ==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CLQCEM2rARgBIhMI77yS5POrlgMVsY-KBx0Epxs4ygEEXADMyQ==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CLQCEM2rARgBIhMI77yS5POrlgMVsY-KBx0Epxs4ygEEXADMyQ==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"Correspondent Week concludes with Everton fan Sean Norton joining James to discuss an Everton side that now have no lack of depth in midfield but still have some concerns in other areas.\n\nAnd midfield should be an area of interest for Everton assets, but Christian Norgaard and James Garner remain doubts for GW1, new signings Hayden Hackney, Brennan Johnson and Tyrique George may not be first choice, Jack Grealish may return and the popular Iliman Ndiaye also carries concerns over his future and output.\n\nYou're still not thinking about Kiernan Dewsbury-Hall. Maybe you should...\n\nJames Tarkowski could do very well again as a DEFCON monster, but is he worth the extra over his cheaper teammates?\n\nPlus, Barry v Beto and lots more...\n\n---------------------------------------------------------------------------------\nIntro: 0:00\nMissing out on Europe: 0:38\nFixtures: 4:10\nNorgaard: 5:47\nHackney: 6:51\nGeorge: 10:10 \nJohnson: 12:43 \nGrealish: 21:48\nPossible Transfers: 23:42\nGarner \u0026 Ndiaye: 27:08\nDewsbury-Hall: 30:28\nOther Midfielders: 35:23\nPickford: 37:31\nTarkowski: 40:57\nOther Defenders: 44:27\nBeto v Barry: 48:57\nPredicted GW1 XI: 50:30\nSeason Expectations: 51:01\nPatreon/Content Plug: 51:47\n----------------------------------------------------------------------------------\n\nNext Week on Planet FPL:\n\nMonday: s. 10 ep. 3 - The Shortlist\n\nTuesday: That Show With Nico ep. 16\n\nWednesday: s. 10 ep. 4 - The Line Ups\n\nThursday: Ask James\n\nFriday: s. 10 ep. 5 - Final Drafts\n\nAnd on Patreon today: The Debrief with Suj and James on today's four Podcasts (IT+) and After The Podcast with today's Correspondents (AT)\n\nThe full schedule for Correspondent Week can be found here: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / correspondent-166192123⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  \n\nWant to become a member of our FPL community and support the Podcast? \n\nJoin us on Patreon: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow James on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfplpod⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Suj on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / sujanshah⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Clayton on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / claytsafc⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Nico on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / nico_semedo⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  \n\nSubscribe to our YouTube channel: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠   / @planetfpl  \n\nLike us on Facebook: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow us on Instagram: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\n#FantasyPremierLeague #FPL #EFC","commandRuns":[{"startIndex":828,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CLQCEM2rARgBIhMI77yS5POrlgMVsY-KBx0Epxs4ygEEXADMyQ==","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=cEy-WNhGEhM","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"cEy-WNhGEhM","continuePlayback":true,"startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr4---sn-a5msen7z.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026olis=1\u0026ofpcc=1\u0026msp=1\u0026odepv=1\u0026id=704cbe58d8461213\u0026ip=68.255.249.182\u0026initcwndbps=1932500\u0026mt=1787114928\u0026oweuc="}}}}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"0 seconds"}}},{"startIndex":856,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CLQCEM2rARgBIhMI77yS5POrlgMVsY-KBx0Epxs4ygEEXADMyQ==","commandMetadat