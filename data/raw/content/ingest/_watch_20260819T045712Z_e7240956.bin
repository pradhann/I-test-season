Style":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293980671,"raisedBackground":4293980671,"additiveBackground":558257097,"textPrimary":4278586169,"textSecondary":4280561028,"invertedBackground":4279837839,"overlayBackground":3422948153},"darkThemeColorPalette":{"baseBackground":4278322205,"raisedBackground":4278586169,"additiveBackground":726029257,"textPrimary":4292796924,"textSecondary":4288653034,"invertedBackground":4286351075,"overlayBackground":3422948153},"enableColorSampledText":true}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"EgtjRXktV05oR0VoTSDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"3,503"},"label":{"simpleText":"Views"},"accessibilityText":"3,503 views","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293980671,"raisedBackground":4293980671,"additiveBackground":558257097,"textPrimary":4278586169,"textSecondary":4280561028,"invertedBackground":4279837839,"overlayBackground":3422948153},"darkThemeColorPalette":{"baseBackground":4278322205,"raisedBackground":4278586169,"additiveBackground":726029257,"textPrimary":4292796924,"textSecondary":4288653034,"invertedBackground":4286351075,"overlayBackground":3422948153},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"Aug 14"},"label":{"simpleText":"2026"},"accessibilityText":"Aug 14, 2026","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293980671,"raisedBackground":4293980671,"additiveBackground":558257097,"textPrimary":4278586169,"textSecondary":4280561028,"invertedBackground":4279837839,"overlayBackground":3422948153},"darkThemeColorPalette":{"baseBackground":4278322205,"raisedBackground":4278586169,"additiveBackground":726029257,"textPrimary":4292796924,"textSecondary":4288653034,"invertedBackground":4286351075,"overlayBackground":3422948153},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAciEwjvvJLk86uWAxWxj4oHHQSnGzjKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/@PlanetFPL","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UC8043oOKTB4uP8Nq15Kz6bg","canonicalBaseUrl":"/@PlanetFPL"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/ytc/AIdro_lhavFK4dKciK04L6ggAxAX9Q9_AnrPDcvbJCV1_3RdVQ=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Correspondent Week concludes with Everton fan Sean Norton joining James to discuss an Everton side that now have no lack of depth in midfield but still have some concerns in other areas.\n\nAnd midfield should be an area of interest for Everton assets, but Christian Norgaard and James Garner remain doubts for GW1, new signings Hayden Hackney, Brennan Johnson and Tyrique George may not be first choice, Jack Grealish may return and the popular Iliman Ndiaye also carries concerns over his future and output.\n\nYou're still not thinking about Kiernan Dewsbury-Hall. Maybe you should...\n\nJames Tarkowski could do very well again as a DEFCON monster, but is he worth the extra over his cheaper teammates?\n\nPlus, Barry v Beto and lots more...\n\n---------------------------------------------------------------------------------\nIntro: 0:00\nMissing out on Europe: 0:38\nFixtures: 4:10\nNorgaard: 5:47\nHackney: 6:51\nGeorge: 10:10 \nJohnson: 12:43 \nGrealish: 21:48\nPossible Transfers: 23:42\nGarner \u0026 Ndiaye: 27:08\nDewsbury-Hall: 30:28\nOther Midfielders: 35:23\nPickford: 37:31\nTarkowski: 40:57\nOther Defenders: 44:27\nBeto v Barry: 48:57\nPredicted GW1 XI: 50:30\nSeason Expectations: 51:01\nPatreon/Content Plug: 51:47\n----------------------------------------------------------------------------------\n\nNext Week on Planet FPL:\n\nMonday: s. 10 ep. 3 - The Shortlist\n\nTuesday: That Show With Nico ep. 16\n\nWednesday: s. 10 ep. 4 - The Line Ups\n\nThursday: Ask James\n\nFriday: s. 10 ep. 5 - Final Drafts\n\nAnd on Patreon today: The Debrief with Suj and James on today's four Podcasts (IT+) and After The Podcast with today's Correspondents (AT)\n\nThe full schedule for Correspondent Week can be found here: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / correspondent-166192123⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  \n\nWant to become a member of our FPL community and support the Podcast? \n\nJoin us on Patreon: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow James on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfplpod⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Suj on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / sujanshah⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Clayton on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / claytsafc⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Nico on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / nico_semedo⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  \n\nSubscribe to our YouTube channel: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠   / @planetfpl  \n\nLike us on Facebook: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow us on Instagram: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\n#FantasyPremierLeague #FPL #EFC","commandRuns":[{"startIndex":828,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwjvvJLk86uWAxWxj4oHHQSnGzjKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=cEy-WNhGEhM","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"cEy-WNhGEhM","continuePlayback":true,"startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5Playbac