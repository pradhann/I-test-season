t":"Likes"},"accessibilityText":"15 likes","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293982463,"raisedBackground":4293982463,"additiveBackground":556633057,"textPrimary":4278395197,"textSecondary":4279392150,"invertedBackground":4279392150,"overlayBackground":3422757181},"darkThemeColorPalette":{"baseBackground":4278259742,"raisedBackground":4278395197,"additiveBackground":724405217,"textPrimary":4292734717,"textSecondary":4287940340,"invertedBackground":4285707245,"overlayBackground":3422757181},"enableColorSampledText":true}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"EgtCZE9YR0h6UUk2dyDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"1,059"},"label":{"simpleText":"Views"},"accessibilityText":"1,059 views","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293982463,"raisedBackground":4293982463,"additiveBackground":556633057,"textPrimary":4278395197,"textSecondary":4279392150,"invertedBackground":4279392150,"overlayBackground":3422757181},"darkThemeColorPalette":{"baseBackground":4278259742,"raisedBackground":4278395197,"additiveBackground":724405217,"textPrimary":4292734717,"textSecondary":4287940340,"invertedBackground":4285707245,"overlayBackground":3422757181},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"Aug 2"},"label":{"simpleText":"2026"},"accessibilityText":"Aug 2, 2026","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293982463,"raisedBackground":4293982463,"additiveBackground":556633057,"textPrimary":4278395197,"textSecondary":4279392150,"invertedBackground":4279392150,"overlayBackground":3422757181},"darkThemeColorPalette":{"baseBackground":4278259742,"raisedBackground":4278395197,"additiveBackground":724405217,"textPrimary":4292734717,"textSecondary":4287940340,"invertedBackground":4285707245,"overlayBackground":3422757181},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAYiEwje4Mnn86uWAxWLlMsBHSbfGMDKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/@FPLFamily","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCDG_EqOaaO1SSxEMZwfrSkg","canonicalBaseUrl":"/@FPLFamily"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/fvXRj8Lye-E-52gmDDmkCErlCuXT-vDI9kvKkN1_pWsEUPzuN7ieOQtjDo_-JiyuLQa4p9Arug=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Sam and Lee are back for their (wait for it...) TENTH season of FPL Family! Welcome along! Thank you all for being here and watching the videos for what is sure to be, another memorable FPL season!\n\n\nThe game's been live for a couple of weeks now, so we've had time to tinker, consider our options and then tinker again. Do we go Bruno, Haaland or both? Where's the value in the forward line? And we ask the eternal pre-season question - who's our go-to 4.0m defender? We'll share our drafts and who's on our watchlists!\n\n\nA massive THANK YOU for all your support watching, liking and sharing our videos!\n\n\n__________________________\n 🚀 Support FPL Family on Patreon:\n\n\n     \n     \n  •  \n     \n     Exclusive FREE Podcasts every week looking ahead to the next GW\n     \n     \n     \n  •  \n     \n     Manager of the Month Competitions  - MONTHLY PRIZES!\n     \n     \n     \n  •  \n     \n     Zoom Video Chats with Lee and Sam\n     \n     \n     \n  •  \n     \n     Slack Chat community with other FPL Managers\n     \n     \n     \n\nJoin for FREE or Support the Channel!\n  (https://www.youtube.com/redirect?even...)  / fplfamily   (https://www.youtube.com/redirect?even...) \n________________________\n 📊 Join the FPLFamily FPL Mini-League!\n55fqu1\n________________________\n🎧 Also available as a Podcast on your favourite Podcast platforms!\n  (https://www.youtube.com/redirect?even...)  / fplfamily   (https://www.youtube.com/redirect?even...) \nhttps://audioboom.com/channels/5010221 (https://www.youtube.com/redirect?even...) \nSearch 'FPL Family' on Spotify, Apple iTunes,  Deezer.\n __________________________\nStats, Season Tickers and Player Ratings provided by Fantasy Football Scout Members Area.\nBecome a member here! - http://Bit.ly/FFScoutFamily (https://www.youtube.com/redirect?even...) \n__________________________   \n 🏃‍♂️ Follow us on Twitter, Instagram and TikTok! - Just Search 'fplfamily'\nhttps://www.x.com/fplfamily (https://www.youtube.com/redirect?even...)  \n  (https://www.youtube.com/redirect?even...)  / fplfamily   (https://www.youtube.com/redirect?even...) \nhttps://www.tiktok.com/fplfamily (https://www.youtube.com/redirect?even...) \n\n #FPL (https://www.youtube.com/hashtag/fpl)  #FPLFamily (https://www.youtube.com/hashtag/fplfa...)  #FantasyPremierLeague (https://www.youtube.com/hashtag/fanta...)  #FPLTips (https://www.youtube.com/hashtag/fpltips)","commandRuns":[{"startIndex":1061,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwje4Mnn86uWAxWLlMsBHSbfGMBIrMfA5ofj5ekFygEEXADMyQ==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVEx5MjdQbFVTbHlHazlsaGM1Y2xIZHxBR3JiS2FsNTlQVGhZYURjaEQyRk9VdWF4NzZhR0Zndm5WN0ZJQURSbjJiRU5ZOXplX3NXMlhEa09XT0VyZW10Nll2a3lCaTJDbWl4NFdIWTQ5b0tMa1hKazZGVFNMTWNhVl9E\u0026q=https%3A%2F%2Fwww.patreon.com%2Ffplfamily\u0026v=3rdlnLCcs54","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVEx5MjdQbFVTbHlHazlsaGM1Y2xIZHxBR3JiS2