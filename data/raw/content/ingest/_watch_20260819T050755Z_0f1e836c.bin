Renderer":{"title":{"runs":[{"text":"25/26 Season Review | FPL BlackBox​ | Fantasy Premier League Tips 25/26 | Up Front"}]},"channel":{"simpleText":"FPL BlackBox"},"views":{"simpleText":"2,294 views"},"publishDate":{"simpleText":"Premiered Jun 11, 2026"},"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAciEwiC8pmX9quWAxUyy9IEHRaYK2LKAQQIZ7zi","commandMetadata":{"webCommandMetadata":{"url":"/@FPLBlackBox","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCGJ8-xqhOLwyJNuPMsVoQWQ","canonicalBaseUrl":"/@FPLBlackBox"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/vcfLQFV4YPNWlLEKHWqiUJnvduo59gy1pLKrvZSk187evBECSb4TlRNpXdSh3JcdcqNqddvR=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Join Az as he takes a comprehensive look through his 25/26 season and looks at the BlackBox lessons he can take into next year.\n----------------------------------------------\n🟢 All team / player stats shown on screen are from Fantasy Football Scout. Az, Andy, and Luke all use the Fantasy Football Scout members area to get their data and help make their decisions. You can sign up and get instant access to this elite Fantasy data here: \n\nGet your FFS Annual Membership here: https://bit.ly/FFScoutBlackBox\n----------------------------------------------\nFor Graphic work comission, contact Trevor Thompson\n📧 trevorthompsondesigner@gmail.com \n----------------------------------------------\n👍 🖋️ Don't forget to Like this video and Subscribe to FPL Blackbox… https://bit.ly/3jwrN96\n\n⬛ … and join the FPL BlackBox league!\nCode: dgetg1\nLink: https://fantasy.premierleague.com/lea...\n----------------------------------------------\n🎫 Become a Channel Member and/or become a Godfather Tier member on Patreon!\n\nJoin the community on Patreon!:    www.patreon.com/fplblackbox     \n\nWe greatly appreciate all SuperChats as a way of supporting the stream! We will do our best to answer these at the end of the stream\n----------------------------------------------\nFollow us:\n\n🅾 INSTAGRAM:   / fplblackbox  \n\n💻 DISCORD:   / discord  \n\n🐦X: https://www.x.com/fplblackbox\n-----------------------------------------------\n#FPLBlackBox #FPL #FantasyPremierLeague #premierleague #GW38 Fantasy Football Scout, Fantasy Football Tips, Fantasy Football Gameweek 38 GW 38\n-----------------------------------------------\nContact us: \n\n📧 Az@fplblackbox.com\n📧 Andy@fplblackbox.com\n📧 Luke@fplblackbox.com\n\nLobby 0:00\nStart 0:05\nSeason Review - A Season of Bad Luck? 2:40\nSeason Review - By Gameweek 7:25\nBlackBox Lessons 42:55\nPlay World Cup GoalScorer Challenge with FPL BlackBox! 48:46","commandRuns":[{"startIndex":478,"length":30,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwiC8pmX9quWAxUyy9IEHRaYK2JI9bO5guauw57rAcoBBAhnvOI=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUzZIMUF0Y0VoVmRGLXBtX2FiMmNZM3xBR3JiS2FrMFlsMmlWSXY5bUpISW1rLUszSGc4MnplWkdoUW5XcDl5QTFqUk54T3dZX003M1dxRTV6RTYwdURUeUt0YlpONi1LaGZ2SEw2N01JNDJ5T2lhaEM3YjBRa1dUYnlI\u0026q=https%3A%2F%2Fbit.ly%2FFFScoutBlackBox\u0026v=6z0NdmBOWfU","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUzZIMUF0Y0VoVmRGLXBtX2FiMmNZM3xBR3JiS2FrMFlsMmlWSXY5bUpISW1rLUszSGc4MnplWkdoUW5XcDl5QTFqUk54T3dZX003M1dxRTV6RTYwdURUeUt0YlpONi1LaGZ2SEw2N01JNDJ5T2lhaEM3YjBRa1dUYnlI\u0026q=https%3A%2F%2Fbit.ly%2FFFScoutBlackBox\u0026v=6z0NdmBOWfU","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":762,"length":22,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwiC8pmX9quWAxUyy9IEHRaYK2JI9bO5guauw57rAcoB