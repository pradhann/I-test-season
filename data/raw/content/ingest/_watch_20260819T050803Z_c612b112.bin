ey":"1610000","value":2569954648},{"key":"1620000","value":2569037137},{"key":"1630000","value":2572838242},{"key":"1640000","value":2568971599},{"key":"1650000","value":2568774989},{"key":"1660000","value":2573559141},{"key":"1670000","value":2568578381},{"key":"1680000","value":2568643917},{"key":"1690000","value":2572838241},{"key":"1700000","value":2568315519},{"key":"1710000","value":2568184447},{"key":"1720000","value":2573555796},{"key":"1730000","value":2568184447},{"key":"1740000","value":2568184447},{"key":"1750000","value":2573555545},{"key":"1760000","value":2568184447},{"key":"1770000","value":2573555796},{"key":"1780000","value":2573555796},{"key":"1790000","value":2573556054},{"key":"1800000","value":2568184447},{"key":"1810000","value":2568184703},{"key":"1820000","value":2573556054},{"key":"1830000","value":2573555787},{"key":"1840000","value":2573555787},{"key":"1850000","value":2573556054}]}}}],"microformat":{"microformatDataRenderer":{"videoDetails":{"comments":[{"type":"https://schema.org/Comment","dateCreated":"2026-08-14T04:14:42-07:00","text":"I remember when LR used to get the good ranks. Wouldn't say he was a great FPL.player as such but he had balls of steel. A term the use in poker is a bit of a chancer . Was willing to risk a season of nothing in return for an outstanding season and can't knock it because not everyone can do that. obviously he's had a pretty horrendous rank for a few years now. I've also noticed that he doesn't really play the way he used to. Last few seasons he's had similar teams to Zoph and Pras. At the start a couple of seasons ago he was like for like with Zophs team until the first WC. What I'm trying to say is you should always play to your personality strength. Not sure if he will ever hit the heights again now everyone using models but he should just go back to doing what he does best imo","author":{"type":"https://schema.org/Person","name":"@DPGkilla","url":"https://www.youtube.com/@DPGkilla","alternateName":"Bozack The Great"},"upvoteCount":15}]}}},"frameworkUpdates":{"entityBatchUpdate":{"mutations":[{"entityKey":"EgZ0b3BiYXIg9QEoAQ%3D%3D","type":"ENTITY_MUTATION_TYPE_DELETE","options":{"persistenceOption":"ENTITY_PERSISTENCE_OPTION_INMEMORY_AND_PERSIST"}},{"entityKey":"EhxsaWtlX2J1dHRvbl9hbmltYXRpb25fZW50aXR5ILcEKAE%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"likeButtonAnimationEntity":{"key":"EhxsaWtlX2J1dHRvbl9hbmltYXRpb25fZW50aXR5ILcEKAE%3D","animationLightUrl":"https://www.gstatic.com/youtube/img/lottie/custom_animated_like_icon/animated_like_soccer_light_v2.json","animationDarkUrl":"https://www.gstatic.com/youtube/img/lottie/custom_animated_like_icon/animated_like_soccer_dark_v2.json"}}},{"entityKey":"EgtjcnN6NnNIemRrOCA-KAE%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"likeStatusEntity":{"key":"EgtjcnN6NnNIemRrOCA-KAE%3D","likeStatus":"INDIFFERENT"}}},{"entityKey":"EhhVQ2NxRXIzRGZyUnd0b0YyYTF5VzhxZ1EgMygB","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"subscriptionStateEntity":{"key":"EhhVQ2NxRXIzRGZyUnd0b0YyYTF5VzhxZ1EgMygB","subscribed":false}}},{"entityKey":"EhhVQ2NxRXIzRGZyUnd0b0YyYTF5VzhxZ1EgjAEoAQ%3D%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"subscriptionNotificationStateEntity":{"key":"EhhVQ2NxRXIzRGZyUnd0b0YyYTF5VzhxZ1EgjAEoAQ%3D%3D","state":"SUBSCRIPTION_NOTIFICATION_STATE_OCCASIONAL"}}},{"entityKey":"EhhVQ3RJUEZleEI2UExLTk5sMFhIM1NLS3cgMygB","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"subscriptionStateEntity":{"key":"EhhVQ3RJUEZleEI2UExLTk5sMFhIM1NLS3cgMygB","subscribed":false}}},{"entityKey":"EhhVQ3RJUEZleEI2UExLTk5sMFhIM1NLS3cgjAEoAQ%3D%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"subscriptionNotificationStateEntity":{"key":"EhhVQ3RJUEZleEI2UExLTk5sMFhIM1NLS3cgjAEoAQ%3D%3D","state":"SUBSCRIPTION_NOTIFICATION_STATE_OCCASIONAL"}}},{"entityKey":"EjFVQ2NxRXIzRGZyUnd0b0YyYTF5VzhxZ1EsVUN0SVBGZXhCNlBMS05ObDBYSDNTS0t3IDMoAQ%3D%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"subscriptionStateEntity":{"key":"