il.com\n___________\n⏱️ Timestamps\n0:00 Intro\n0:30 My New FPL Draft\n18:00 Outro\n___________\n\n#fpl  #fantasypremierleague  #premierleague #gw1","commandRuns":[{"startIndex":28,"length":32,"onTap":{"innertubeCommand":{"clickTrackingParams":"CPEBEM2rARgBIhMImuzK2fOrlgMVPjizBR1gYB7fSOWtqJXv-N3dxQHKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUUxIUEE2SHJvRFFJQlZJeHpnQWcydnxBR3JiS2FtMUJDMlJ1V1VuTTBDcVBYWFN1eXltZ3AxSktfTHpiNXJ3NTNMc3M3X3pnY0NIMy1ydXJWcXczdFc0M3U1X21TdXJwcWRvNHZBc095WmF4V1lmNjRXQzcwR0p4bF84\u0026q=https%3A%2F%2Fwww.clubga.me%2FUfSc%2FHarry\u0026v=xbt3xvKqFuU","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUUxIUEE2SHJvRFFJQlZJeHpnQWcydnxBR3JiS2FtMUJDMlJ1V1VuTTBDcVBYWFN1eXltZ3AxSktfTHpiNXJ3NTNMc3M3X3pnY0NIMy1ydXJWcXczdFc0M3U1X21TdXJwcWRvNHZBc095WmF4V1lmNjRXQzcwR0p4bF84\u0026q=https%3A%2F%2Fwww.clubga.me%2FUfSc%2FHarry\u0026v=xbt3xvKqFuU","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":208,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CPEBEM2rARgBIhMImuzK2fOrlgMVPjizBR1gYB7fSOWtqJXv-N3dxQHKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUU5QVTVHMjRuOE5mdjFkYmZ0SDJzanxBR3JiS2FuVE5wNG5xVU1EZ1ZPbE5jQ1dDdTRvVmluUkk1VjNwd01ZaXFSbGFyTkFRQkVSSHpuYUpIU0tLZ0E4d0NEOVVsUDlFWnJsellrX3hWQ21lYTRGSkZvZ0VpMUNWVm8z\u0026q=https%3A%2F%2Ffantasy.premierleague.com%2Fleagues%2Fauto-join%2Fa6fgym\u0026v=xbt3xvKqFuU","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUU5QVTVHMjRuOE5mdjFkYmZ0SDJzanxBR3JiS2FuVE5wNG5xVU1EZ1ZPbE5jQ1dDdTRvVmluUkk1VjNwd01ZaXFSbGFyTkFRQkVSSHpuYUpIU0tLZ0E4d0NEOVVsUDlFWnJsellrX3hWQ21lYTRGSkZvZ0VpMUNWVm8z\u0026q=https%3A%