			<dc:creator><![CDATA[Always Cheating Media LLC]]></dc:creator>
			<pubDate>Mon, 15 Nov 2021 05:06:00 GMT</pubDate>
			<enclosure url="https://anchor.fm/s/10622ff04/podcast/play/104097656/https%3A%2F%2Fd3ctxlq1ktw2nl.cloudfront.net%2Fstaging%2F2025-5-13%2F402121460-44100-2-edd5c7301bea9fd8.mp3" length="84537088" type="audio/mpeg"/>
