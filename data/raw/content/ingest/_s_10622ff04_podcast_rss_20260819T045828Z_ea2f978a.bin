			<dc:creator><![CDATA[Always Cheating Media LLC]]></dc:creator>
			<pubDate>Mon, 03 Oct 2022 04:08:31 GMT</pubDate>
			<enclosure url="https://anchor.fm/s/10622ff04/podcast/play/104097675/https%3A%2F%2Fd3ctxlq1ktw2nl.cloudfront.net%2Fstaging%2F2025-5-13%2F402121519-44100-2-8a32970bd2d00e8e.mp3" length="69580065" type="audio/mpeg"/>
