sonality strength. Not sure if he will ever hit the heights again now everyone using models but he should just go back to doing what he does best imo","author":{"type":"https://schema.org/Person","name":"@DPGkilla","url":"https://www.youtube.com/@DPGkilla","alternateName":"Bozack The Great"},"upvoteCount":15}]}}},"frameworkUpdates":{"entityBatchUpdate":{"mutations":[{"entityKey":"EgZ0b3BiYXIg9QEoAQ%3D%3D","type":"ENTITY_MUTATION_TYPE_DELETE","options":{"persistenceOption":"ENTITY_PERSISTENCE_OPTION_INMEMORY_AND_PERSIST"}},{"entityKey":"EhxsaWtlX2J1dHRvbl9hbmltYXRpb25fZW50aXR5ILcEKAE%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"likeButtonAnimationEntity":{"key":"EhxsaWtlX2J1dHRvbl9hbmltYXRpb25fZW50aXR5ILcEKAE%3D","animationLightUrl":"https://www.gstatic.com/youtube/img/lottie/custom_animated_like_icon/animated_like_soccer_light_v2.json","animationDarkUrl":"https://www.gstatic.com/youtube/img/lottie/custom_animated_like_icon/animated_like_soccer_dark_v2.json"}}},{"entityKey":"EgtjcnN6NnNIemRrOCA-KAE%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"likeStatusEntity":{"key":"EgtjcnN6NnNIemRrOCA-KAE%3D","likeStatus":"INDIFFERENT"}}},{"entityKey":"EhhVQ2NxRXIzRGZyUnd0b0YyYTF5VzhxZ1EgMygB","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"subscriptionStateEntity":{"key":"EhhVQ2NxRXIzRGZyUnd0b0YyYTF5VzhxZ1EgMygB","subscribed":false}}},{"entityKey":"EhhVQ2NxRXIzRGZyUnd0b0YyYTF5VzhxZ1EgjAEoAQ%3D%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"subscriptionNotificationStateEntity":{"key":"EhhVQ2NxRXIzRGZyUnd0b0YyYTF5VzhxZ1EgjAEoAQ%3D%3D","state":"SUBSCRIPTION_NOTIFICATION_STATE_OCCASIONAL"}}},{"entityKey":"EhhVQ3RJUEZleEI2UExLTk5sMFhIM1NLS3cgMygB","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"subscriptionStateEntity":{"key":"EhhVQ3RJUEZleEI2UExLTk5sMFhIM1NLS3cgMygB","subscribed":false}}},{"entityKey":"EhhVQ3RJUEZleEI2UExLTk5sMFhIM1NLS3cgjAEoAQ%3D%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"subscriptionNotificationStateEntity":{"key":"EhhVQ3RJUE