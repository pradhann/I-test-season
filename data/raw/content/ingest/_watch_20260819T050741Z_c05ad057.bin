"2400000","value":2575242519},{"key":"2410000","value":2575242013},{"key":"2420000","value":2574402112},{"key":"2430000","value":2575242011},{"key":"2440000","value":2575244832},{"key":"2450000","value":2575242012},{"key":"2460000","value":2574399287},{"key":"2470000","value":2575242010},{"key":"2480000","value":2575243807},{"key":"2490000","value":2575242008},{"key":"2500000","value":2574403396},{"key":"2510000","value":2575244066},{"key":"2520000","value":2574401858},{"key":"2530000","value":2575242010},{"key":"2540000","value":2574402114},{"key":"2550000","value":2575244321},{"key":"2560000","value":2575242003},{"key":"2570000","value":2574401343},{"key":"2580000","value":2574401858},{"key":"2590000","value":2575247652},{"key":"2600000","value":2575244067},{"key":"2610000","value":2575242010},{"key":"2620000","value":2575242015},{"key":"2630000","value":2575242523},{"key":"2640000","value":2575242008},{"key":"2650000","value":2575242008},{"key":"2660000","value":2575244064},{"key":"2670000","value":2575242008},{"key":"2680000","value":2575244573},{"key":"2690000","value":2575242008},{"key":"2700000","value":2575245342},{"key":"2710000","value":2575244585},{"key":"2720000","value":2575242013},{"key":"2730000","value":2575242008},{"key":"2740000","value":2575242014},{"key":"2750000","value":2575242007},{"key":"2760000","value":2575244828},{"key":"2770000","value":2575242010},{"key":"2780000","value":2575242014},{"key":"2790000","value":2575242266},{"key":"2800000","value":2575242008},{"key":"2810000","value":2575242010},{"key":"2820000","value":2575242008},{"key":"2830000","value":2575242010},{"key":"2840000","value":2575242014},{"key":"2850000","value":2575242008},{"key":"2860000","value":2575242014},{"key":"2870000","value":2575244573},{"key":"2880000","value":2575249456},{"key":"2890000","value":2575248168},{"key":"2900000","value":2575243034},{"key":"2910000","value":2575250995},{"key":"2920000","value":2575247143},{"key":"2930000","value":2575242522},{"key":"2940000","value":2574403395},{"key":"2950000","value":2575245858},{"key":"2960000","value":2575245099},{"key":"2970000","value":2575242012},{"key":"2980000","value":2575244071},{"key":"2990000","value":2575242014},{"key":"3000000","value":2575242010},{"key":"3010000","value":2575243813},{"key":"3020000","value":2574402629},{"key":"3030000","value":2575242011},{"key":"3040000","value":2575244587},{"key":"3050000","value":2575242008},{"key":"3060000","value":2575242008},{"key":"3070000","value":2575242010},{"key":"3080000","value":2575250229},{"key":"3090000","value":2575243802},{"key":"3100000","value":2575242008},{"key":"3110000","value":2575242008},{"key":"3120000","value":2575248940},{"key":"3130000","value":2575242010},{"key":"3140000","value":2575242008},{"key":"3150000","value":2575243542},{"key":"3160000","value":2575242010},{"key":"3170000","value":2575242010},{"key":"3180000","value":2575242008},{"key":"3190000","value":2575246377},{"key":"3200000","value":2575242010},{"key":"3210000","value":2575242263},{"key":"3220000","value":2575242010},{"key":"3230000","value":2575242266},{"key":"3240000","value":2575242008},{"key":"3250000","value":2575242008}]}}}],"microformat":{"microformatDataRenderer":{"videoDetails":{"comments":[{"type":"https://schema.org/Comment","dateCreated":"2026-08-14T11:00:49-07:00","text":"Great correspondent debut from Lauren! I think good season for us would be a top 3 finish, strong UCL campaign and restoring the feeling we can beat anybody on our day like I felt during Klopp's reign, even when things weren't always that rosy.\n\nSquad is thin especially up front, but Isak and Wirtz should show us why they are amongst the very best players in their positions in the World. I think we'll sign Barcola and at the very least have the 2nd best attack in the league behind ManCity. I'd sell Gakpo, if Spurs bids silly amount and then sign a proper RW.\n\nDefence could be an issue, if the players don't have the legs and lungs to play the high tempo style 90 minutes twice a week and there are too much space for the opponents to exploit. I'd like to see a new starting RB still, but that probably won't happen with Araujo offering some cover in there too.\n\nFPL-wise I had Isak on my first draft but have since dropped him as J.Pedro seems too good to ignore at 7.5 and having both with Haaland and Bruno is too much for me, but I'd still be more than happy to see Isak to absolutely smash the early opponents. Wirtz over Szobo for me as well and I'll likely start the season with just Wirtz from LFC on my team.\n\nThanks for James \u0026 co for great Correspondent Week content as always! I've watched every episode and made some minor tweaks on my team along the way.","author":{"type":"https://schema.org/Person","name":"@LFCippe","url":"https://www.youtube.com/@LFCippe","alternateName":"LFC ippe"},"upvoteCount":11}]}}},"frameworkUpdates":{"entityBatchUpdate":{"mutations":[{"entityKey":"EgZ0b3BiYXIg9QEoAQ%3D%3D","type":"ENTITY_MUTATION_TYPE_DELETE","options":{"persistenceOption":"ENTITY_PERSISTENCE_OPTION_INMEMORY_AND_PERSIST"}},{"entityKey":"EhxsaWtlX2J1dHRvbl9hbmltYXRpb25fZW50aXR5ILcEKAE%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"likeButtonAnimationEntity":{"key":"EhxsaWtlX2J1dHRvbl9hbmltYXRpb25fZW50aXR5ILcEKAE%3D","animationLightUrl":"https://www.gstatic.com/youtube/img/lottie/custom_animated_like_icon/animated_like_soccer_light_v2.json","animationDarkUrl":"https://www.gstatic.com/youtube/img/lottie/custom_animated_like_icon/animated_like_soccer_dark_v2.json"}}},{"entityKey":"EgstdjhBZDNxaFk4MCA-KAE%3D","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"likeStatusEntity":{"key":"EgstdjhBZDNxaFk4MCA-KAE%3D","likeStatus":"INDIFFERENT"}}},{"entityKey":"EhhVQzgwNDNvT0tUQjR1UDhOcTE1S3o2YmcgMygB","type":"ENTITY_MUTATION_TYPE_REPLACE","payload":{"subscriptionStateEntity":{"key":"EhhVQzgwNDNvT0tUQjR1UDhOcTE1S3o2YmcgMygB","subscribed":false}}}],"timestamp":{"seconds":"1787116062","nanos":939193061}}}};</script><scr