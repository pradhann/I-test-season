.co.uk\n\n🐦   / fplmate  \n📸   / fplmate  \n🎶   / fplmate  \n🎮   / fpl_mate  \n👾   / discord  \n🏆 Join:    / @fplmate  \n️⚽️ FPL Mate league link: https://fantasy.premierleague.com/lea...\n️⚽️ FPL Mate league code: behupk\n\n#fpl #fantasypremierleague #premierleague","commandRuns":[{"startIndex":38,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CIECEM2rARgBIhMI2eLQ8fOrlgMVuoTLAR2rGhr1SL3h2Ni5vrbLC8oBBFwAzMk=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUXNndmxYNm9wRXJjMUZIbXYwWFR5U3xBR3JiS2FsRDAycHQ2bFNya3lkMEFzclhxSlpQQ2lWb1lGOUwtXzhQX0hCUGZhOTBFTThJYUJpdzJkWi1mazJ5cFRnekNfRXkxVFF5Y0R1YUxtT0VDcVdqbU9hUW80VkEwTFE1\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Flanding%2Ffplmate%3Futm_source%3Daffiliate%26utm_medium%3Daffiliates%26utm_campaign%3DFPLMate%26utm_content%3Dyoutube%26via%3DFPLMate\u0026v=C5bZ85sWML0","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUXNndmxYNm9wRXJjMUZIbXYwWFR5U3xBR3JiS2FsRDAycHQ2bFNya3lkMEFzclhxSlpQQ2lWb1lGOUwtXzhQX0hCUGZhOTBFTThJYUJpdzJkWi1mazJ5cFRnekNfRXkxVFF5Y0R1YUxtT0VDcVdqbU9hUW80VkEwTFE1\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Flanding%2Ffplmate%3Futm_source%3Daffiliate%26utm_medium%3Daffiliates%26utm_campaign%3DFPLMate%26utm_content%3Dyoutube%26via%3DFPLMate\u0026v=C5bZ85sWML0","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":79,"length":3,"onTap":{"innertubeCommand":{"clickTrackingParams":"CIUCENzXBBgpIhMI2eLQ8fOrlgMVuoTLAR2rGhr1ygEEXADMyQ==","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/ad","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUGCgJhZBgB"}}},"loggingDirectives":{"trackingParams":"CIUCENzXBBgpIhMI2eLQ8fOrlgMVuoTLAR2rGhr1"}},{"startIndex":512,"length":4,"onTap":{"innertubeCommand":{"cli