loggers and content creators under one roof. If you're looking for fantasy football advice, we are the channel for you.\n\n#FPL #FantasyPremierLeague #PremierLeague","isCrawlable":true,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/uK4XX3moBco/hqdefault.jpg?sqp=-oaymwEmCKgBEF5IWvKriqkDGQgBFQAAAAAYASUAAMhCPQCAokN4AbgC9xg=\u0026rs=AOn4CLC1bJ6PbJY7tpic0H4X7cDiDYCITA","width":168,"height":94},{"url":"https://i.ytimg.com/vi/uK4XX3moBco/hqdefault.jpg?sqp=-oaymwEmCMQBEG5IWvKriqkDGQgBFQAAAAAYASUAAMhCPQCAokN4AbgC9xg=\u0026rs=AOn4CLDarGpRtBtKwd4mbTvwu84kTwyO9A","width":196,"height":110},{"url":"https://i.ytimg.com/vi/uK4XX3moBco/hqdefault.jpg?sqp=-oaymwEnCPYBEIoBSFryq4qpAxkIARUAAAAAGAElAADIQj0AgKJDeAG4AvcY\u0026rs=AOn4CLAy3OXRnjonJPP3nLnZufiWFCYXzA","width":246,"height":138},{"url":"https://i.ytimg.com/vi/uK4XX3moBco/hqdefault.jpg?sqp=-oaymwEnCNACELwBSFryq4qpAxkIARUAAAAAGAElAADIQj0AgKJDeAG4AvcY\u0026rs=AOn4CLDxWO3g2SoPhBBhwurEOfBcUZDt5w","width":336,"height":188},{"url":"https://i.ytimg.com/vi/uK4XX3moBco/maxresdefault.jpg","width":1920,"height":1080}]},"allowRatings":true,"viewCount":"12957","author":"Fantasy Football Hub","isPrivate":false,"isUnpluggedCorpus":false,"isLiveContent":false,"isTvfilmVideo":false},"annotations":[{"playerAnnotationsExpandedRenderer":{"featuredChannel":{"startTimeMs":"0","endTimeMs":"742000","watermark":{"thumbnails":[{"url":"https://i.ytimg.com/an/cqEr3DfrRwtoF2a1yW8qgQ/featured_channel.jpg?v=62c70bf5","width":40,"height":40}]},"trackingParams":"CBoQ8zciEwi764Sb9quWAxWLyy0AHVIhFu0=","navigationEndpoint":{"clickTrackingParams":"CBoQ8zciEwi764Sb9quWAxWLyy0AHVIhFu0yAml2ygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"/channel/UCcqEr3DfrRwtoF2a1yW8qgQ","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCcqEr3DfrRwtoF2a1yW8qgQ"}},"channelName":"Fantasy Football Hub","subscribeButton":{"subscribeButtonRenderer":{"buttonText":{"runs":[{"text":"SUBSCRIBE"}]},"subscri