"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"21 Down, 17 to go!\n\nWildcard windows are open and we had the pleasure of being joined by Ivan and Jonny as we look at how teams could be made up heading in to double/blank season.\n\n💬 Join the conversation in the comments: What’s your process?\n\n#fantasypremierleague   #PremierLeague #football #fpl     \n\n=====================================================================\n\nAll our Links:\n\nhttp://bit.ly/AAFPLApple\nhttp://bit.ly/AAFPLSpotify\nhttps://bit.ly/AAFPLWebsite\n\nSupport us over on Patreon\n  / aboveaveragefpl  \n\n=============================================================\n\nTimestamps:\n\nCredit to:\n\nPodcast Support: CryptoBlockDan - https://www.hubble.social/danhibell \nMotion Design: https://shawbird.webflow.io\nOverlays/Thumbnails: https://x.com/AlexVolloFPL\n\n===============================================================","commandRuns":[{"startIndex":245,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CC4Q3NcEGEMiEwjSnoP286uWAxVHkooHHY-VCCXKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fantasypremierleague","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUYChRmYW50YXN5cHJlbWllcmxlYWd1ZRgB"}}},"loggingDirectives":{"trackingParams":"CC4Q3NcEGEMiEwjSnoP286uWAxVHkooHHY-VCCU="}},{"startIndex":269,"length":14,"onTap":{"innertubeCommand":{"clickTrackingParams":"CC0Q3NcEGEQiEwjSnoP286uWAxVHkooHHY-VCCXKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/premierleague","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gURCg1wcmVtaWVybGVhZ3VlGAE%3D"}}},"loggingDirectives":{"trackingParams":"CC0Q3NcEGEQiEwjSnoP286uWAxVHkooHHY-VCCU="}},{"startIndex":284,"le