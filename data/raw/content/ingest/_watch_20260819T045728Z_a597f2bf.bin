ackBox\n\n💻 DISCORD:   / discord  \n\n🐦X: https://www.x.com/fplblackbox\n-----------------------------------------------\n#FPLBlackBox #FPL #FantasyPremierLeague #premierleague #GW1 Fantasy Football Scout, Fantasy Football Tips, Fantasy Football Gameweek 1 GW 1\n-----------------------------------------------\nContact us: \n\n📧 Az@fplblackbox.com\n📧 Andy@fplblackbox.com\n📧 Luke@fplblackbox.com","commandRuns":[{"startIndex":433,"length":30,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwjR4evr86uWAxWdSfIAHYdqBpBI39X73p2jpJzUAcoBBFwAzMk=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUXhPdWxIWXNvbjVqY2FZOU5pTnc1aXxBR3JiS2FtQ2RZVXlOZmtoeXF0cW8yN2llaDBNSm5oSzBZdGZiNDBjYjRLckQweld0bUU4QkJ4NnZXenhCWTFab1RhWjNjSVFMVnUwMGdCbzhoQVdhYU1zOFJtUFkzY2pLbkFq\u0026q=https%3A%2F%2Fbit.ly%2FFFScoutBlackBox\u0026v=1DiRGdve6t8","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUXhPdWxIWXNvbjVqY2FZOU5pTnc1aXxBR3JiS2FtQ2RZVXlOZmtoeXF0cW8yN2llaDBNSm5oSzBZdGZiNDBjYjRLckQweld0bUU4QkJ4NnZXenhCWTFab1RhWjNjSVFMVnUwMGdCbzhoQVdhYU1zOFJtUFkzY2pLbkFq\u0026q=https%3A%2F%2Fbit.ly%2FFFScoutBlackBox\u0026v=1DiRGdve6t8","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":718,"length":22,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwjR4evr86uWAxWdSfIAHYdqBpBI39X73p2jpJzUAcoBBFwAzMk=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVHlKRVpPaVl6aDVXeHdVVEs1aTlGX3xBR3JiS2FreE4tTEhacjRiVVVvMVdGcXNCblZ4aEFWeUtKVlRmdVJkWF9uMGxseVVVWnM2cEtMeFZLZl84OGRHNkFDbGZzRVJvNXRrdlB4RnlyNV8wSXE2NlFqNXJPeTZkQVVp\u0026q=https%3A%2F%2Fbit.ly%2F3jwrN96\u0026v=1DiRGdve6t8","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u002