tubei/v1/browse/edit_playlist"}},"playlistEditEndpoint":{"playlistId":"WL","actions":[{"addedVideoId":"rFEnUn-oc68","action":"ACTION_ADD_VIDEO"}]}},"removeFromWatchLaterCommand":{"clickTrackingParams":"CAAQu2kiEwjSqpHl86uWAxVzxhYJHbiAIujKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/browse/edit_playlist"}},"playlistEditEndpoint":{"playlistId":"WL","actions":[{"action":"ACTION_REMOVE_VIDEO_BY_VIDEO_ID","removedVideoId":"rFEnUn-oc68"}]}}}}},"storyboards":{"playerStoryboardSpecRenderer":{"spec":"https://i.ytimg.com/sb/rFEnUn-oc68/storyboard3_L$L/$N.jpg?sqp=-oaymwGhAUg48quKqQOYAYgBAZUBAAAEQpgBMqABPKgBBLIBQBANDBAVHyYtDg4PEhcrLCkPDhAVHyoyKQ8RFBgmPTgtERQeKjFLRzYVHCkuOUdNPyUuNz1HUlFFM0BCQ0xERkO6AUARERUjRENDQxETFi9DQ0NDFRYpQ0NDQ0MjL0NDQ0NDQ0RDQ0NDQ0JCQ0NDQ0NCQkJDQ0NDQkJCQkNDQ0JCQkJCovOX_wMGCIrc99MG|48#27#100#10#10#0#default#rs$AOn4CLDdEOwkwclmptGxePEUCX1w6TZPGQ|80#45#344#10#10#10000#M$M#rs$AOn4CLBVELJkWSo4xYy4oWreaJ_Pbhwd8w|160#90#344#5#5#10000#M$M#rs$AOn4CLARq8XIvtiVoji64WPOpEoOtYsqxQ|320#180#344#3#3#10000#M$M#rs$AOn4CLBcoaPDtRxOVTi3CH8VkHnFKENyNg","recommendedLevel":3,"fineScrubbingRecommendedLevel":2,"highResolutionRecommendedLevel":3}},"microformat":{"playerMicroformatRenderer":{"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/rFEnUn-oc68/maxresdefault.jpg","width":1280,"height":720}]},"embed":{"iframeUrl":"https://www.youtube.com/embed/rFEnUn-oc68","width":1280,"height":720},"title":{"simpleText":"Newcastle United with Simon Bibby | Correspondent Week ep. 18 | Planet FPL 2026/27"},"description":{"simpleText":"It was a late summer of change for Newcastle with Eddie Howe stepping down after pre season had already begun, with Matthias Jaissle the replacement.\n\nSimon Bibby joins James to discuss what we should expect next under Jaissle and why despite the loss of several key players and concerns about what's to come, there may still be FPL gems we want to keep in mind.\n\nThere's a new no.1, Lewis Hall and Malick Thiaw will want monitoring for different reasons, there are three 6.0 forwards to consider and the standout might not be who was expected, and there's some midfielders at cheap prices who may do well.\n\nBut additions are also definitely required!\n\n---------------------------------------------------------------------------------\n- Intro: 0:00\n- Howe: 0:46\n- Jaissle \u0026 Tactics: 3:08\n- Departures: 10:23\n- Fixtures: 17:38\n- Signings: 21:14\n- What's Needed?: 27:13\n- Forwards: 33:51\n- 6.0 Midfielders: 39:15\n- Defenders: 43:10\n- Predicted GW1 XI: 47:26\n- Season Expectations: 55:48\n----------------------------------------------------------------------------------\n\nNext on Correspondent Week: ep. 19 with Lauren Harris on Liverpool\n\nAnd later on Planet FPL: Correspondent Week episode 20 with Sean Norton on Everton\n\nAnd on Patreon: The Debrief with Suj and James on today's four Podcasts (IT+) and After The Podcast with today's Correspondents (AT)\n\nThe full schedule for Correspondent Week can be found here: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠https://www.patreon.com/planetfpl/posts/correspondent-166192123⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠\n\nWant to become a member of our FPL community and support the Podcast? \n\nJoin us on Patreon: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠https://www.patreon.com/planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠\n\nFollow James on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠https://twitter.com/PlanetFPLPod⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠\n\nFollow Suj on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠https://twitter.com/sujanshah⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠\n\nFollow Clayton on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠https://twitter.com/claytsAFC⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠\n\nFollow Nico on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠https://twitter.com/nico_semedo⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠\n\nSubscribe to our YouTube channel: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠https://www.youtube.com/@PlanetFPL\n\nLike us on Facebook: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠