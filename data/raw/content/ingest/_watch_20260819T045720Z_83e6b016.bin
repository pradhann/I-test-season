4"},"label":{"simpleText":"2026"},"accessibilityText":"May 24, 2026","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293982463,"raisedBackground":4293982463,"additiveBackground":556633057,"textPrimary":4278395197,"textSecondary":4279392150,"invertedBackground":4279392150,"overlayBackground":3422757181},"darkThemeColorPalette":{"baseBackground":4278259742,"raisedBackground":4278395197,"additiveBackground":724405217,"textPrimary":4292734717,"textSecondary":4287940340,"invertedBackground":4285707245,"overlayBackground":3422757181},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAYiEwibgP7n86uWAxWGjIoHHeGhGNLKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/@FPLFamily","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCDG_EqOaaO1SSxEMZwfrSkg","canonicalBaseUrl":"/@FPLFamily"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/fvXRj8Lye-E-52gmDDmkCErlCuXT-vDI9kvKkN1_pWsEUPzuN7ieOQtjDo_-JiyuLQa4p9Arug=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"So there we have it - an FPL season for the AGES...\n\n\nCongratulations Arsenal - Champions for the first time in 22 years! And on the other side of North London - RELIEF! Spurs stay up, so De Zerbi lives to fight another season, despite some nervy moments at the Tottenham Hotspur Stadium earlier today. Elsewhere, Sunderland - yes SUNDERLAND - make Europe, but Chelsea miss out altogether. With Alonso coming in over the summer though, does that make them more attractive potentially for next season's FPL.\n\n\nWe also reveal what we all thought was going to happen back in GW1, when we made our pre-season predictions!\n\n\nA massive THANK YOU for all your support watching, liking and sharing our videos!\n\n\n__________________________\n 🚀 Support FPL Family on Patreon:\n\n\n     \n     \n  •  \n     \n     Exclusive FREE Podcasts every week looking ahead to the next GW\n     \n     \n     \n  •  \n     \n     Manager of the Month Competitions  - MONTHLY PRIZES!\n     \n     \n     \n  •  \n     \n     Zoom Video Chats with Lee and Sam\n     \n     \n     \n  •  \n     \n     Slack Chat community with other FPL Managers\n     \n     \n     \n\nJoin for FREE or Support the Channel!\n  (https://www.youtube.com/redirect?even...)  / fplfamily   (https://www.youtube.com/redirect?even...) \n________________________\n 📊 Join the FPLFamily FPL Mini-League!\n5162cw\n________________________\n🎧 Also available as a Podcast on your favourite Podcast platforms!\n  (https://www.youtube.com/redirect?even...)  / fplfamily   (https://www.youtube.com/redirect?even...) \nhttps://audioboom.com/channels/5010221 (https://www.youtube.com/redirect?even...) \nSearch 'FPL Family' on Spotify, Apple iTunes,  Deezer.\n __________________________\nStats, Season Tickers and Player Ratings provided by Fantasy Football Scout Members Area.\nBecome a member here! - http://Bit.ly/FFScoutFamily (https://www.youtube.com/redirect?even...) \n__________________________   \n 🏃‍♂️ Follow us on Twitter, Instagram and TikTok! - Just Search 'fplfamily'\nhttps://www.x.com/fplfamily (https://www.youtube.com/redirect?even...)  \n  (https://www.youtube.com/redirect?even...)  / fplfamily   (https://www.youtube.com/redirect?even...) \nhttps://www.tiktok.com/fplfamily (https://www.youtube.com/redirect?even....","commandRuns":[{"startIndex":1158,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwibgP7n86uWAxWGjIoHHeGhGNJInYCRtaL9pLYMygEEXADMyQ==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqa1NmUUdEUl