  <title>S5 Ep21: GW23/24 - DENNIS THE MENACE - FPL Family (Fantasy Premier League)</title>
  <link>https://audioboom.com/posts/8017696</link>
  <itunes:episode>21</itunes:episode>
  <itunes:title>GW23/24 - DENNIS THE MENACE - FPL Family (Fantasy Premier League)</itunes:title>
  <itunes:season>5</itunes:season>
  <enclosure url="https://audioboom.com/posts/8017696.mp3?modified=1642976304&amp;sid=5010221&amp;source=rss" length="65329845" type="audio/mpeg" />
