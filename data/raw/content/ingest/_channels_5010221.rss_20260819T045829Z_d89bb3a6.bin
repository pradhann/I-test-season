  <title>S9 Ep23: Gabriel and Cherki IN? Wirtz finding form! FPL GW18-GW19 Fantasy Premier League Hints &amp; Tips</title>
  <link>https://audioboom.com/posts/8824204</link>
  <itunes:episode>23</itunes:episode>
  <itunes:title>Gabriel and Cherki IN? Wirtz finding form! FPL GW18-GW19 Fantasy Premier League Hints &amp; Tips</itunes:title>
  <itunes:season>9</itunes:season>
  <enclosure url="https://audioboom.com/posts/8824204.mp3?modified=1766964492&amp;sid=5010221&amp;source=rss" length="96280105" type="audio/mpeg" />
