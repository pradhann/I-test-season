<item>
  <title>S8 Ep17: FPL GW13/14 - Saka &amp; Gabriel look ESSENTIAL! - (Fantasy Premier League Tips 2024/2025)</title>
  <link>https://audioboom.com/posts/8616641</link>
  <itunes:episode>17</itunes:episode>
  <itunes:title>FPL GW13/14 - Saka &amp; Gabriel look ESSENTIAL! - (Fantasy Premier League Tips 2024/2025)</itunes:title>
  <itunes:season>8</itunes:season>
  <enclosure url="https://audioboom.com/posts/8616641.mp3?modified=1733095336&amp;sid=5010221&amp;source=rss" length="82608612" type="audio/mpeg" />
  <itunes:image href="https://audioboom.com/i/41133983.png" />
