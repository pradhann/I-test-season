<item>
  <title>S5 Ep18: GW18/19 - Should we be playing FPL differently now? - FPL Family (Fantasy Premier League)</title>
  <link>https://audioboom.com/posts/8000373</link>
  <itunes:episode>18</itunes:episode>
  <itunes:title>GW18/19 - Should we be playing FPL differently now? - FPL Family (Fantasy Premier League)</itunes:title>
  <itunes:season>5</itunes:season>
  <enclosure url="https://audioboom.com/posts/8000373.mp3?modified=1639951265&amp;sid=5010221&amp;source=rss" length="72847674" type="audio/mpeg" />
