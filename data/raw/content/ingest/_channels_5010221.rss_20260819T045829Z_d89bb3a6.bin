<item>
  <title>S5 Ep30: GW34/35 - Kane and Son: SELL or HOLD? - FPL Family (Fantasy Premier League)</title>
  <link>https://audioboom.com/posts/8071876</link>
  <itunes:episode>30</itunes:episode>
  <itunes:title>GW34/35 - Kane and Son: SELL or HOLD? - FPL Family (Fantasy Premier League)</itunes:title>
  <itunes:season>5</itunes:season>
  <enclosure url="https://audioboom.com/posts/8071876.mp3?modified=1650885640&amp;sid=5010221&amp;source=rss" length="65917854" type="audio/mpeg" />
