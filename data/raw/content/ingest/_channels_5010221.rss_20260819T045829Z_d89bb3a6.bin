<item>
  <title>GW38 Voice Note: Team Sam vs Team Lee - it COULD NOT be closer!</title>
  <link>https://audioboom.com/posts/8307038</link>
  <enclosure url="https://audioboom.com/posts/8307038.mp3?modified=1685012108&amp;sid=5010221&amp;source=rss" length="9135359" type="audio/mpeg" />
