<item>
  <title>GW11 Voice Note: Liverpool 2.0 in FPL - powered by Dom Szoboszlai</title>
  <link>https://audioboom.com/posts/8393831</link>
  <enclosure url="https://audioboom.com/posts/8393831.mp3?modified=1698863503&amp;sid=5010221&amp;source=rss" length="12319772" type="audio/mpeg" />
  <itunes:image href="https://audioboom.com/i/40823423.png" />
