  <title>S7 Ep8: WILDCARD TIME! SAM HITS THE BUTTON - FPL Family (Fantasy Premier League Tips 2023/2024)</title>
  <link>https://audioboom.com/posts/8376926</link>
  <itunes:episode>8</itunes:episode>
  <itunes:title>WILDCARD TIME! SAM HITS THE BUTTON - FPL Family (Fantasy Premier League Tips 2023/2024)</itunes:title>
  <itunes:season>7</itunes:season>
  <enclosure url="https://audioboom.com/posts/8376926.mp3?modified=1696194475&amp;sid=5010221&amp;source=rss" length="89842177" type="audio/mpeg" />
