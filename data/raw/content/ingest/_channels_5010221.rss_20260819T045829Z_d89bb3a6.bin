<item>
  <title>S9 Ep28: Arsenal DOMINATE Spurs!! FPL GW27-GW28 Fantasy Premier League Hints &amp; Tips</title>
  <link>https://audioboom.com/posts/8864536</link>
  <itunes:episode>28</itunes:episode>
  <itunes:title>Arsenal DOMINATE Spurs!! FPL GW27-GW28 Fantasy Premier League Hints &amp; Tips</itunes:title>
  <itunes:season>9</itunes:season>
  <enclosure url="https://audioboom.com/posts/8864536.mp3?modified=1771802239&amp;sid=5010221&amp;source=rss" length="84238134" type="audio/mpeg" />
