<item>
  <title>S8 Ep7: ICE COLD! COLE PALMER IS BACK! GW2/GW3 - FPL Family (Fantasy Premier League Tips 2024/2025)</title>
  <link>https://audioboom.com/posts/8561085</link>
  <itunes:episode>7</itunes:episode>
  <itunes:title>ICE COLD! COLE PALMER IS BACK! GW2/GW3 - FPL Family (Fantasy Premier League Tips 2024/2025)</itunes:title>
  <itunes:season>8</itunes:season>
