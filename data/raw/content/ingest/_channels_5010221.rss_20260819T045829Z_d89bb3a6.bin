  <title>S7 Ep27: WILDCARD SUCCESS OR FAIL? GW36 - FPL Family (Fantasy Premier League Tips 2023/2024)</title>
  <link>https://audioboom.com/posts/8497321</link>
  <itunes:episode>27</itunes:episode>
  <itunes:title>WILDCARD SUCCESS OR FAIL? GW36 - FPL Family (Fantasy Premier League Tips 2023/2024)</itunes:title>
  <itunes:season>7</itunes:season>
  <enclosure url="https://audioboom.com/posts/8497321.mp3?modified=1714343934&amp;sid=5010221&amp;source=rss" length="81140611" type="audio/mpeg" />
