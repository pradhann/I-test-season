  <title>GW29 Voice Notes: Midweek Musings...</title>
  <link>https://audioboom.com/posts/8271532</link>
  <enclosure url="https://audioboom.com/posts/8271532.mp3?modified=1680167184&amp;sid=5010221&amp;source=rss" length="8940460" type="audio/mpeg" />
