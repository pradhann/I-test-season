<item>
  <title>S9 Ep31:  Best WILDCARD Picks for the Break! FPL GW31-GW32 Fantasy Premier League</title>
  <link>https://audioboom.com/posts/8877430</link>
  <itunes:episode>31</itunes:episode>
  <itunes:title> Best WILDCARD Picks for the Break! FPL GW31-GW32 Fantasy Premier League</itunes:title>
  <itunes:season>9</itunes:season>
  <enclosure url="https://audioboom.com/posts/8877430.mp3?modified=1774221024&amp;sid=5010221&amp;source=rss" length="86434174" type="audio/mpeg" />
  <itunes:image href="https://audioboom.com/i/43543853/s=1400x1400/el=1/rt=fill.png" />
