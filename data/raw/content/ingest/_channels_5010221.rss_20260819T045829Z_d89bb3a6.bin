<item>
  <title>S9 Ep2: Were Spurs right to sack Big Ange?</title>
  <link>https://audioboom.com/posts/8733675</link>
  <itunes:episode>2</itunes:episode>
  <itunes:title>Were Spurs right to sack Big Ange?</itunes:title>
  <itunes:season>9</itunes:season>
