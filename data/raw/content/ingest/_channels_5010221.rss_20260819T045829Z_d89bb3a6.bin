<item>
  <title>S9 Ep5: RATING EACH OTHER'S FIRST DRAFTS! Bench Boost GW1? Fantasy Premier League FPL 2025/26</title>
  <link>https://audioboom.com/posts/8755227</link>
  <itunes:episode>5</itunes:episode>
  <itunes:title>RATING EACH OTHER'S FIRST DRAFTS! Bench Boost GW1? Fantasy Premier League FPL 2025/26</itunes:title>
  <itunes:season>9</itunes:season>
