  <title>FPL Voice Notes: DGW27 Announced!</title>
  <link>https://audioboom.com/posts/8245466</link>
  <enclosure url="https://audioboom.com/posts/8245466.mp3?modified=1676050041&amp;sid=5010221&amp;source=rss" length="8932426" type="audio/mpeg" />
  <itunes:image href="https://audioboom.com/i/40082066/s=1400x1400/el=1/rt=fill.jpg" />
