<item>
  <title>S5 Ep28: GW32/33 - FPL talking points from Man City v Liverpool - FPL Family (Fantasy Premier League)</title>
  <link>https://audioboom.com/posts/8064542</link>
  <itunes:episode>28</itunes:episode>
  <itunes:title>GW32/33 - FPL talking points from Man City v Liverpool - FPL Family (Fantasy Premier League)</itunes:title>
  <itunes:season>5</itunes:season>
