<item>
  <title>GW19 Voice Notes: Mitrovic gets the dreaded booking, Lampard on the edge</title>
  <link>https://audioboom.com/posts/8224320</link>
  <enclosure url="https://audioboom.com/posts/8224320.mp3?modified=1672841269&amp;sid=5010221&amp;source=rss" length="9898911" type="audio/mpeg" />
