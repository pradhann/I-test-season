<item>
  <title>S9 Ep17: NO LIVERPOOL players from GW12!?...GW11-12 (Fantasy Premier League FPL Tips 2025/2026)</title>
  <link>https://audioboom.com/posts/8804083</link>
  <itunes:episode>17</itunes:episode>
  <itunes:title>NO LIVERPOOL players from GW12!?...GW11-12 (Fantasy Premier League FPL Tips 2025/2026)</itunes:title>
  <itunes:season>9</itunes:season>
  <enclosure url="https://audioboom.com/posts/8804083.mp3?modified=1762729869&amp;sid=5010221&amp;source=rss" length="84261553" type="audio/mpeg" />
  <itunes:image href="https://audioboom.com/i/43183766/s=1400x1400/el=1/rt=fill.jpg" />
