<item>
  <title>S3 Ep38: The Road to Madrid 2019 Pt1 - FPL Family x PlanetFPL - Champions League Memories</title>
  <link>https://audioboom.com/posts/7554045</link>
  <itunes:episode>38</itunes:episode>
  <itunes:title>The Road to Madrid 2019 Pt1 - FPL Family x PlanetFPL - Champions League Memories</itunes:title>
  <itunes:season>3</itunes:season>
