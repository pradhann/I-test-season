<item>
  <title>S8 Ep26: FPL GW25/26 - Marmoush &amp; Merino keep the pressure on! - (Fantasy Premier League Tips 2024/2025)</title>
  <link>https://audioboom.com/posts/8654689</link>
  <itunes:episode>26</itunes:episode>
  <itunes:title>FPL GW25/26 - Marmoush &amp; Merino keep the pressure on! - (Fantasy Premier League Tips 2024/2025)</itunes:title>
  <itunes:season>8</itunes:season>
  <enclosure url="https://audioboom.com/posts/8654689.mp3?modified=1739745559&amp;sid=5010221&amp;source=rss" length="78582173" type="audio/mpeg" />
