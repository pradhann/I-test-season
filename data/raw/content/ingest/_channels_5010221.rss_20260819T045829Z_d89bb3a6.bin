  <title>S6 Ep26: SHOULD WE SELL HAALAND? - GW28 - FPL Family (Fantasy Premier League Tips 2022/2023)</title>
  <link>https://audioboom.com/posts/8262562</link>
  <itunes:episode>26</itunes:episode>
  <itunes:title>SHOULD WE SELL HAALAND? - GW28 - FPL Family (Fantasy Premier League Tips 2022/2023)</itunes:title>
  <itunes:season>6</itunes:season>
