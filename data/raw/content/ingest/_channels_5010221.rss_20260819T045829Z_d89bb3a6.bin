<item>
  <title>GW3 Voice Note: Why I'm selling Salah this week</title>
  <link>https://audioboom.com/posts/8356209</link>
  <enclosure url="https://audioboom.com/posts/8356209.mp3?modified=1692894289&amp;sid=5010221&amp;source=rss" length="9551963" type="audio/mpeg" />
  <itunes:image href="https://audioboom.com/i/40823423.png" />
