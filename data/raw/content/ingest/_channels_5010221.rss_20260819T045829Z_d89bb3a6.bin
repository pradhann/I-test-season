<item>
  <title>S6 Ep11: SO... ARE WE CAPTAINING SALAH NOW? - GW12 - FPL Family (Fantasy Premier League Tips 2022/2023)</title>
  <link>https://audioboom.com/posts/8175628</link>
  <itunes:episode>11</itunes:episode>
  <itunes:title>SO... ARE WE CAPTAINING SALAH NOW? - GW12 - FPL Family (Fantasy Premier League Tips 2022/2023)</itunes:title>
  <itunes:season>6</itunes:season>
