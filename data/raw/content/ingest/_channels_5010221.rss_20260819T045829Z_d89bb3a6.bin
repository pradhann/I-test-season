<item>
  <title>S8 Ep25: FPL GW24/25 - Assistant Manager Chip CHAOS! - (Fantasy Premier League Tips 2024/2025)</title>
  <link>https://audioboom.com/posts/8647576</link>
  <itunes:episode>25</itunes:episode>
  <itunes:title>FPL GW24/25 - Assistant Manager Chip CHAOS! - (Fantasy Premier League Tips 2024/2025)</itunes:title>
  <itunes:season>8</itunes:season>
