<item>
  <title>GW20 Voice Notes: First -4 of the season and Brighton’s £4.9m gem!</title>
  <link>https://audioboom.com/posts/8227918</link>
  <enclosure url="https://audioboom.com/posts/8227918.mp3?modified=1673463680&amp;sid=5010221&amp;source=rss" length="9346923" type="audio/mpeg" />
