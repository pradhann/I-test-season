<item>
  <title>S8 Ep23: FPL GW22/23 - Time to ditch Arsenal double-defence?  - (Fantasy Premier League Tips 2024/2025)</title>
  <link>https://audioboom.com/posts/8640009</link>
  <itunes:episode>23</itunes:episode>
  <itunes:title>FPL GW22/23 - Time to ditch Arsenal double-defence?  - (Fantasy Premier League Tips 2024/2025)</itunes:title>
  <itunes:season>8</itunes:season>
