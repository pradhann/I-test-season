<item>
  <title>S7 Ep12: ARE WE STILL BUYING ARSENAL? - GW12 - FPL Family (Fantasy Premier League Tips 2023/2024)</title>
  <link>https://audioboom.com/posts/8395685</link>
  <itunes:episode>12</itunes:episode>
  <itunes:title>ARE WE STILL BUYING ARSENAL? - GW12 - FPL Family (Fantasy Premier League Tips 2023/2024)</itunes:title>
  <itunes:season>7</itunes:season>
