<item>
  <title>S6 Ep22: GW24 - SHOULD WE BUY INTO NEW-LOOK CHELSEA? - FPL Family (Fantasy Premier League Tips 2022/2023)</title>
  <link>https://audioboom.com/posts/8246157</link>
  <itunes:episode>22</itunes:episode>
  <itunes:title>GW24 - SHOULD WE BUY INTO NEW-LOOK CHELSEA? - FPL Family (Fantasy Premier League Tips 2022/2023)</itunes:title>
  <itunes:season>6</itunes:season>
