<item>
  <title>S9 Ep38: Season 25/26 is OVER! Deadline CHAOS and Pre-Season Predictions Revealed! Fantasy Premier League</title>
  <link>https://audioboom.com/posts/8907447</link>
  <itunes:episode>38</itunes:episode>
  <itunes:title>Season 25/26 is OVER! Deadline CHAOS and Pre-Season Predictions Revealed! Fantasy Premier League</itunes:title>
  <itunes:season>9</itunes:season>
  <enclosure url="https://audioboom.com/posts/8907447.mp3?modified=1779662699&amp;sid=5010221&amp;source=rss" length="69257266" type="audio/mpeg" />
  <itunes:image href="https://audioboom.com/i/42921105.jpg" />
