<item>
  <title>S8 Ep24: FPL GW23/24 - Best Liverpool &amp; Everton Picks for the DGW - (Fantasy Premier League Tips 2024/2025)</title>
  <link>https://audioboom.com/posts/8643422</link>
  <itunes:episode>24</itunes:episode>
  <itunes:title>FPL GW23/24 - Best Liverpool &amp; Everton Picks for the DGW - (Fantasy Premier League Tips 2024/2025)</itunes:title>
  <itunes:season>8</itunes:season>
  <enclosure url="https://audioboom.com/posts/8643422.mp3?modified=1737932783&amp;sid=5010221&amp;source=rss" length="87505920" type="audio/mpeg" />
