  <link>https://audioboom.com/posts/7953759</link>
  <itunes:episode>10</itunes:episode>
  <itunes:title>Key Transfer Targets for the International Break - GW7/8 - FPL Family (Fantasy Premier League)</itunes:title>
  <itunes:season>5</itunes:season>
  <enclosure url="https://audioboom.com/posts/7953759.mp3?modified=1633296125&amp;sid=5010221&amp;source=rss" length="72989613" type="audio/mpeg" />
