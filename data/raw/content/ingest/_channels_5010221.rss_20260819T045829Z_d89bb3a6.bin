<item>
  <title>S9 Ep11: Haaland CLINICAL in the Derby! GW4-5 (Fantasy Premier League FPL Tips 2025/2026)</title>
  <link>https://audioboom.com/posts/8776935</link>
  <itunes:episode>11</itunes:episode>
  <itunes:title>Haaland CLINICAL in the Derby! GW4-5 (Fantasy Premier League FPL Tips 2025/2026)</itunes:title>
  <itunes:season>9</itunes:season>
  <enclosure url="https://audioboom.com/posts/8776935.mp3?modified=1757889610&amp;sid=5010221&amp;source=rss" length="88609147" type="audio/mpeg" />
  <itunes:image href="https://audioboom.com/i/42921105.jpg" />
