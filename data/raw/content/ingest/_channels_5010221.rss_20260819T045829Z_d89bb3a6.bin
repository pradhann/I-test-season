<item>
  <title>S9 Ep32: GW32 Wildcard CANCELLED?! FPL Family - Fantasy Premier League</title>
  <link>https://audioboom.com/posts/8883394</link>
  <itunes:episode>32</itunes:episode>
  <itunes:title>GW32 Wildcard CANCELLED?! FPL Family - Fantasy Premier League</itunes:title>
  <itunes:season>9</itunes:season>
  <enclosure url="https://audioboom.com/posts/8883394.mp3?modified=1775423470&amp;sid=5010221&amp;source=rss" length="36388771" type="audio/mpeg" />
  <itunes:image href="https://audioboom.com/i/42939125/s=1400x1400/el=1/rt=fill.png" />
