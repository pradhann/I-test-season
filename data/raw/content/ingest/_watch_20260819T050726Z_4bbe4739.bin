-Time | Fáb...  \n   • FPL's Worst EVER Disasters  \n   • If 11/12 Messi was in FPL | IMPOSSIBLE Sco...   \n━━━━━━━━━━━━━\n🏆 Mini-league Champions\n25/26: David Whitlock\n24/25: Lovro Budišin\n23/24: Jonas Sand Låbakk\n22/23: Leo Karaj\n21/22: Ben Osman\n20/21: Kiran Paul\n━━━━━━━━━━━━━\n🎵 Song credit: Harris Heller - Cielo\n━━━━━━━━━━━━━\n#FPL #FantasyPremierLeague #PremierLeague","commandRuns":[{"startIndex":15,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwidvYqJ9quWAxWYy9IEHVaoGtRIxtX5yduBqum8AcoBBAhnvOI=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rU2hkNVFMM2ZvODZKQloxOFdRN1RDNHxBR3JiS2FsVUoyOU5Sdm95VmM4SG9oQWdaaXE0ZjZMTHVscnVxNG5zNmo2ZWFGUXlTcl9DbXpjeVA0VHlPUWZXVHVERUt5QnNJZWRJNFdlT1JXMjVQdDZKUlM3b1Z4NG5MNDd0\u0026q=https%3A%2F%2Fs.id%2FFPLFocal\u0026v=vNKoDbk-asY","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rU2hkNVFMM2ZvODZKQloxOFdRN1RDNHxBR3JiS2FsVUoyOU5Sdm95VmM4SG9oQWdaaXE0ZjZMTHVscnVxNG5zNmo2ZWFGUXlTcl9DbXpjeVA0VHlPUWZXVHVERUt5QnNJZWRJNFdlT1JXMjVQdDZKUlM3b1Z4NG5MNDd0\u0026q=https%3A%2F%2Fs.id%2FFPLFocal\u0026v=vNKoDbk-asY","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":221,"length":26,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwidvYqJ9quWAxWYy9IEHVaoGtRIxtX5yduBqum8AcoBBAhnvOI=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUzdZZ1BFUjVjSFdMYVpBeWlBbDZPTHxBR3JiS2FsMTRjMFNSVEdDS3k0T3hBSFhUTjQxdl9VaUNKSWxwb25RYV9YeEl6NkE1cG1meWczNmVRUzdibHdCa2hHU2FHeEQ5MF9wRjJkOExWMTBXVEtpVG9EYXpRaHpxWThJ\u0026q=https%3A%2F%2Ffpl.page%2Fsubscribe\u0026v=vNKoDbk-asY","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUzdZZ1B