researchuk.or...\n\nAll our Links:\n\n🔗http://bit.ly/AAFPLApple\n🔗http://bit.ly/AAFPLSpotify\n🔗https://bit.ly/AAFPLWebsite","commandRuns":[{"startIndex":0,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCMQ3NcEGB0iEwipre6f9quWAxUeJbMFHdkSId_KAQQIZ7zi","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/fantasypremierleague","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUYChRmYW50YXN5cHJlbWllcmxlYWd1ZRgB"}}},"loggingDirectives":{"trackingParams":"CCMQ3NcEGB0iEwipre6f9quWAxUeJbMFHdkSId8="}},{"startIndex":22,"length":14,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCIQ3NcEGB4iEwipre6f9quWAxUeJbMFHdkSId_KAQQIZ7zi","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/premierleague","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gURCg1wcmVtaWVybGVhZ3VlGAE%3D"}}},"loggingDirectives":{"trackingParams":"CCIQ3NcEGB4iEwipre6f9quWAxUeJbMFHdkSId8="}},{"startIndex":37,"length":9,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCEQ3NcEGB8iEwipre6f9quWAxUeJbMFHdkSId_KAQQIZ7zi","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/football","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUMCghmb290YmFsbBgB"}}},"loggingDirectives":{"trackingParams":"CCEQ3NcEGB8iEwipre6f9quWAxUeJbMFHdkSId8="}},{"startIndex":71,"length":15,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCAQsfcEGCAiEwipre6f9quWAxUeJbMFHdkSId_KAQQIZ7zi","commandMetadata":{"webCommandMetadata":{"url":"/@TheExtraInch","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCDdPEKKeI_h0dF7pobSVvRA","canonicalBaseUrl":"/@TheExtraInch"}}},"loggingDirectives":{"trackingParams":"CCAQsfcEGCAiEwipre6f9quWAxUeJbMFHdkSId8="}},{"startIndex":190,"length":21,"onTap":{