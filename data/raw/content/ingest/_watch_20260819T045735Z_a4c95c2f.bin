:   / ffh_hq  \n✅ TikTok:   / ffh_hq  \n🔵 Facebook:   / ffootballhub  \n🐦 Jack's Twitter:   / redditoryt  \n🐦 Will's Twitter:   / ffh_will  \n🐦 Edited By Stevo:   / editor_stevo  \n━━━━━━━━━━━━━\nABOUT 💭\nFantasy Football Hub brings you the very best Fantasy Premier League tools, players, writers, bloggers and content creators under one roof. If you're looking for fantasy football advice, we are the channel for you.\n\n#FPL #FantasyPremierLeague #PremierLeague","commandRuns":[{"startIndex":36,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwiCvJ3v86uWAxWqNrMFHVcjHeBIyougzffrhde4AcoBBFwAzMk=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVEtTODh5N3RBdnRDOWJfYmJ0aHFSRXxBR3JiS2FrM2U2QVRSdGIweFBmaDNXTnhTMkVDdUlSYlVwWlRiMlI1dmRRRmdCeWFHTWdvYk1XeHp2RlZxVlpfa0JKUkZBN0JtVDVKMURvUktJd2JjWV83RFdyNUtVcDV5eVZ2\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Fai-team-rating%3Futm_source%3Dyoutube%26utm_medium%3Dhubyoutube%26utm_campaign%3Djack26%26via%3Djack26\u0026v=uK4XX3moBco","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVEtTODh5N3RBdnRDOWJfYmJ0aHFSRXxBR3JiS2FrM2U2QVRSdGIweFBmaDNXTnhTMkVDdUlSYlVwWlRiMlI1dmRRRmdCeWFHTWdvYk1XeHp2RlZxVlpfa0JKUkZBN0JtVDVKMURvUktJd2JjWV83RFdyNUtVcDV5eVZ2\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Fai-team-rating%3Futm_source%3Dyoutube%26utm_medium%3Dhubyoutube%26utm_campaign%3Djack26%26via%3Djack26\u0026v=uK4XX3moBco","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":212,"length":5,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwiCvJ3v86uWAxWqNrMFHVcjHeDKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=uK4XX3moBco","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"uK4XX3moBco","continuePlayback":true,"startTimeSeconds":0,"watchEndpointSup