,"invertedBackground":4285710829,"overlayBackground":3422758973},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"Aug 14"},"label":{"simpleText":"2026"},"accessibilityText":"Aug 14, 2026","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293982719,"raisedBackground":4293982719,"additiveBackground":556638433,"textPrimary":4278396989,"textSecondary":4279395990,"invertedBackground":4279395990,"overlayBackground":3422758973},"darkThemeColorPalette":{"baseBackground":4278260510,"raisedBackground":4278396989,"additiveBackground":724410593,"textPrimary":4292735741,"textSecondary":4287943156,"invertedBackground":4285710829,"overlayBackground":3422758973},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAciEwjEoLud9quWAxUhGLMFHXBYGIXKAQQIZ7zi","commandMetadata":{"webCommandMetadata":{"url":"/@FPLMate","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCweDAlFm2LnVcOqaFU4_AGA","canonicalBaseUrl":"/@FPLMate"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/qAQEk85x07sEvJWq1fo1ldbHQSKaIbTYlQF9ncIiym36qbHD1KLimJA2TQLtGmNYOZLaLyDTEA=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Win your league or your money back 👉 https://go.fantasyfootballhub.co.uk/l... #ad\n\nIt's time to rate all of the best midfielder picks for Fantasy Premier League 2026/27 GW1!\n\nIn this video I will go through players in the midfield position, and rank them in order of best to worst. Who are the best defs picks? Wirtz, Szoboszlai or Semenyo for GW1? Or is there any differentials or cheap bargain picks? Hopefully these tips will help you decide which players to go for in your Gameweek 1 team selection squad.\n\n0:00 Intro\n0:54 £4.5m Midfielders\n3:28 £5.0m Midfielders\n9:49 £5.5m Midfielders\n14:42 £6.0m Midfielders\n20:19 £6.5m Midfielders\n24:25 £7.0m Midfielders\n30:07 £8.0m+ Midfielders\n\nIf you like what you see, subscribe and become my latest mate!\n\n📧 Business enquiries: dan@fplmate.co.uk\n\n🐦   / fplmate  \n📸   / fplmate  \n🎶   / fplmate  \n🎮   / fpl_mate  \n👾   / discord  \n🏆 Join:    / @fplmate  \n️⚽️ FPL Mate league link: https://fantasy.premierleague.com/lea...\n️⚽️ FPL Mate league code: behupk\n\n#fpl #fantasypremierleague #premierleague","commandRuns":[{"startIndex":38,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwjEoLud9quWAxUhGLMFHXBYGIVIveHY2Lm-tssLygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUjA3QzJSZWJaYXFHYUpNM2N0WDBhLXxBR3JiS2FsY1MzcF9ZQmlPRHhpYXdOcG03bWN0VDY4NnhYdGQ2c1lUeEFuOXN0alZ0ZmVfWjEyV3h4cWZWeTZsQm9FVzZySWpVUV85U0Y4UnREU1NlLWgxUU9FVTZaYmpzOXRB\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Flanding%2Ffplmate%3Futm_source%3Daffiliate%26utm_medium%3Daffiliates%26utm_campaign%3DFPLMate%26utm_content%3Dyoutube%26via%3DFPLMate\u0026v=C5bZ85sWML0","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUjA3QzJSZWJaYXFHYUpNM2N0WDBhLXxBR3JiS2FsY1MzcF9ZQmlPRHhpYXdOcG03bWN0VDY4NnhYdGQ2c1lUeEFuOXN0alZ0ZmVfWjEyV3h4cWZWeTZsQm9FVzZySWpVUV85U0Y4UnREU1NlLWgxUU9FVTZaYmpzOXRB\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Flanding%2Ffplmate%3Futm_source%3Daffiliate%26utm_medium%3Daffiliates%26utm_campaign%3DFPLMate%26utm_content%3Dyoutube%26via%3DFPLMate\u0026v=C5bZ85sWML0","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":79,"length":3,"onTap":{"innertubeCommand":{"clickTrackingParams":"CDYQ3NcEGH4iE