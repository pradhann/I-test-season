ound":4285712621,"overlayBackground":3422759741},"colorSampledDescriptionBodyText":{"content":"Get your FPL Team rated FOR FREE ⤵️\nhttps://go.fantasyfootballhub.co.uk/a...\n━━━━━━━━━━━━━\n@Redditor chats to FPL expert BigManBakar who reveals his team for Gameweek 1 of the Fantasy Premier League 2026/27 season!\n━━━━━━━━━━━━━\nCHAPTERS 📖\n00:00 Intro\n00:30 Haaland\n08:39 Goalkeepers\n10:23 Defenders\n18:37 Midfielders\n26:49 Wirtz\n30:47 Forwards\n34:42 Team Rating\n36:08 Overall Team Thoughts\n38:37 AI Transfers\n41:32 Final Thoughts\n━━━━━━━━━━━━━\nFOLLOW US 👇\n🎯 Site: https://fantasyfootballhub.co.uk/\n🐦 Hub Twitter:   / ffh_hq  \n📸 Instagram:   / ffh_hq  \n✅ TikTok:   / ffh_hq  \n🔵 Facebook:   / ffootballhub  \n🐦 Jack's Twitter:   / redditoryt  \n🐦 Will's Twitter:   / ffh_will  \n🐦 Edited By Stevo:   / editor_stevo  \n━━━━━━━━━━━━━\nABOUT 💭\nFantasy Football Hub brings you the very best Fantasy Premier League tools, players, writers, bloggers and content creators under one roof. If you're looking for fantasy football advice, we are the channel for you.\n\n#FPL #FantasyPremierLeague #PremierLeague","commandRuns":[{"startIndex":36,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwiSg8yZ9quWAxWMlIoHHaSjGjJI8sD1ioO065lhygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUVhrQzVVWlYxdzE1UDNnSkhubDRsc3xBR3JiS2FtTjI0dzJUUzhpUkVuQVZsZ2JrbU5pOXlJYmpsdkREbzRJT24tLThIMHpaRTZCMjUzUE1GRzhmWUhtcE5KWWYyWXZiQV9LM0dZN21KcGZkMlotTF9IemNFTHdlUjJW\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Fai-team-rating%3Futm_source%3Dyoutube%26utm_medium%3Dhubyoutube%26utm_campaign%3Djack26%26via%3Djack26\u0026v=YTOtoDFdYHI","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUVhrQzVVWlYxdzE1UDNnSkhubDRsc3xBR3JiS2FtTjI0dzJUUzhpUkVuQVZsZ2JrbU5pOXlJYmpsdkREbzRJT24tLT