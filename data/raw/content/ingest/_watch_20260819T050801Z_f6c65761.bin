ootball Hub brings you the very best Fantasy Premier League tools, players, writers, bloggers and content creators under one roof. If you're looking for fantasy football advice, we are the channel for you.\n\n#FPL #FantasyPremierLeague #PremierLeague","isCrawlable":true,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/YTOtoDFdYHI/hqdefault.jpg?sqp=-oaymwEmCKgBEF5IWvKriqkDGQgBFQAAAAAYASUAAMhCPQCAokN4AbgC9xg=\u0026rs=AOn4CLDjJROxFPCHoiXmF_PN3NMr-q8Ciw","width":168,"height":94},{"url":"https://i.ytimg.com/vi/YTOtoDFdYHI/hqdefault.jpg?sqp=-oaymwEmCMQBEG5IWvKriqkDGQgBFQAAAAAYASUAAMhCPQCAokN4AbgC9xg=\u0026rs=AOn4CLCCrBs9yM8UiZSq1GuWJ75ff9PCwg","width":196,"height":110},{"url":"https://i.ytimg.com/vi/YTOtoDFdYHI/hqdefault.jpg?sqp=-oaymwEnCPYBEIoBSFryq4qpAxkIARUAAAAAGAElAADIQj0AgKJDeAG4AvcY\u0026rs=AOn4CLAo3dDiNEvvZzn4qhWAFSNEypAIGg","width":246,"height":138},{"url":"https://i.ytimg.com/vi/YTOtoDFdYHI/hqdefault.jpg?sqp=-oaymwEnCNACELwBSFryq4qpAxkIARUAAAAAGAElAADIQj0AgKJDeAG4AvcY\u0026rs=AOn4CLAXcqRgGCX35i-siLatKCFxKE34og","width":336,"height":188},{"url":"https://i.ytimg.com/vi/YTOtoDFdYHI/maxresdefault.jpg","width":1920,"height":1080}]},"allowRatings":true,"viewCount":"43706","author":"Fantasy Football Hub","isPrivate":false,"isUnpluggedCorpus":false,"isLiveContent":false,"isTvfilmVideo":false},"annotations":[{"playerAnnotationsExpandedRenderer":{"featuredChannel":{"startTimeMs":"0","endTimeMs":"2587000","watermark":{"thumbnails":[{"url":"https://i.ytimg.com/an/cqEr3DfrRwtoF2a1yW8qgQ/featured_channel.jpg?v=62c70bf5","width":40,"height":40}]},"trackingParams":"CAkQ8zciEwi59suZ9quWAxVT1y0AHfCmGrs=","navigationEndpoint":{"clickTrackingParams":"CAkQ8zciEwi59suZ9quWAxVT1y0AHfCmGrsyAml2ygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"/channel/UCcqEr3DfrRwtoF2a1yW8qgQ","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCcqEr3DfrRwtoF2a1yW8qgQ"}},"channelName":"Fantasy Football Hub","subscribeBu