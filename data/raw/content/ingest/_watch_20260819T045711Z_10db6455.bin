"subscribeEndpoint":{"channelIds":["UC8043oOKTB4uP8Nq15Kz6bg"],"params":"EgIIBxgA"}},"unsubscribeCommand":{"clickTrackingParams":"CAAQu2kiEwjf1NTj86uWAxXkSEwIHZq9JKDKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/unsubscribe"}},"unsubscribeEndpoint":{"channelIds":["UC8043oOKTB4uP8Nq15Kz6bg"],"params":"CgIIBxgA"}},"addToWatchLaterCommand":{"clickTrackingParams":"CAAQu2kiEwjf1NTj86uWAxXkSEwIHZq9JKDKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/browse/edit_playlist"}},"playlistEditEndpoint":{"playlistId":"WL","actions":[{"addedVideoId":"FC1yISHGc5M","action":"ACTION_ADD_VIDEO"}]}},"removeFromWatchLaterCommand":{"clickTrackingParams":"CAAQu2kiEwjf1NTj86uWAxXkSEwIHZq9JKDKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/browse/edit_playlist"}},"playlistEditEndpoint":{"playlistId":"WL","actions":[{"action":"ACTION_REMOVE_VIDEO_BY_VIDEO_ID","removedVideoId":"FC1yISHGc5M"}]}}}}},"storyboards":{"playerStoryboardSpecRenderer":{"spec":"https://i.ytimg.com/sb/FC1yISHGc5M/storyboard3_L$L/$N.jpg?sqp=-oaymwGhAUg48quKqQOYAYgBAZUBAAAEQpgBMqABPKgBBLIBQBANDBAVHyYtDg4PEhcrLCkPDhAVHyoyKQ8RFBgmPTgtERQeKjFLRzYVHCkuOUdNPyUuNz1HUlFFM0BCQ0xERkO6AUARERUjRENDQxETFi9DQ0NDFRYpQ0NDQ0MjL0NDQ0NDQ0RDQ0NDQ0JCQ0NDQ0NCQkJDQ0NDQkJCQkNDQ0JCQkJCovOX_wMGCP2IjNQG|48#27#100#10#10#0#default#rs$AOn4CLCGbRxeEmx2kgHgNQMZa_1HtoWFJA|80#45#594#10#10#10000#M$M#rs$AOn4CLApbKkJ-OrzLxy5FnBFweRHWQbS4Q|160#90#594#5#5#10000#M$M#rs$AOn4CLAUFe9JJNGrusIMwzcg8EzxNKrgLg|320#180#594#3#3#10000#M$M#rs$AOn4CLBwnTqkbiD8ikFqyBji8n4mtF_etg","recommendedLevel":3,"fineScrubbingRecommendedLevel":2,"highResolutionRecommendedLevel":3}},"microformat":{"playerMicroformatRenderer":{"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/FC1yISHGc5M/maxresdefault.jpg","width":1280,"height":720}]},"embed":{"iframeUrl":"https://www.youtube.com/embed/FC1yISHGc5M","width":1280,"height":720},"title":{"simpleText":"The Shortlist | Planet FPL S. 10 Ep. 3 | Fantasy Premier League"},"description":{"simpleText":"With Correspondent Week done and each club having now played their final pre-season fixture, Suj and James discuss what's left with a definitive guide to their Shortlist of players under consideration and those who may appeal to others.\n\nThere's discussion on favoured early season strategy, James gives us a wrap of all the key information from the final friendlies and opinions that may have evolved from the Correspondent Week podcasts and then there's coverage of every position and price point and who the preferred choices are.\n\n---------------------------------------------------------------------------------\n- Intro: 0:00\n- Content Schedule: 1:30\n- The Teams: 4:30\n- Summary of weekend friendlies: 10:04\n- Big 3: 26:15\n- Goalkeepers: 30:46\n- 6.5 DEFs: 38:02\n- 6.0 DEFs: 42:08\n- 5.5 DEFs: 44:46\n- 5.0 DEFs: 49:02\n- 4.5 DEFs: 54:41\n- 4.0 DEFs: 59:14\n- 8.0-9.5 MIDs: 1:01:05\n- 7.5 MIDs: 1:06:00\n- 7.0 MIDs: 1:08:14\n- 6.5 MIDs: 1:10:32\n- 6.0 MIDs: 1:16:31\n- 5.5 MIDs: 1:20:05\n- 4.5-5.0 MIDs: 1:22:14\n- 6.5-9.0 FWDs: 1:28:52\n- 6.0 FWDs: 1:32:06\n- 4.5-5.5 FWDs: 1:35:11\n- Outro: 1:37:34\n----------------------------------------------------------------------------------\n\nTomorrow on Planet FPL: That Show With Nico ep. 16\n\nToday on Patreon: Patreon QNA (IT+) \u0026 Nico's Corner (AT)\n\nThe full Planet FPL schedule for this week can be found via this post: https://www.patreon.com/planetfpl/posts/content-schedule-166900524\n\nWant to become a member of our FPL community and support the Podcast? \n\nJoin us on Patreon: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠https://www.patreon.com/planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠\n\nFollow James on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠https://t