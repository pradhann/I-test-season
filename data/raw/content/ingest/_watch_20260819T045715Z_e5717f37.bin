rMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2400,"length":2,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2402,"length":21,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2423,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2424,"length":4,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2428,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2429,"length":9,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964720,"raisedBackground":4294964720,"additiveBackground":566850373,"textPrimary":4281735434,"textSecondary":4285614903,"invertedBackground":4287578649,"overlayBackground":3426097418},"darkThemeColorPalette":{"baseBackground":4280027906,"raisedBackground":4281735434,"additiveBackground":734622533,"textPrimary":4294633952,"textSecondary":4292852906,"invertedBackground":4293107580,"overlayBackground":3426097418},"colorSampledDescriptionBodyText":{"content":"On the opening Podcast of the final day of Correspondent Week James is joined by Coventry fan Andrew O'Gorman to discuss all things about The Championship Winners ahead of next Friday's opener at Arsenal.\n\nBut it's the following week that will have FPL managers particularly interested, A Bench Boost GW2 strategy heavily involves a play to get the right Coventry assets for their game against Hull.\n\nAll the 4.0 defenders assessed, new signings covered, and there may be some 5.0 forwards starting the season. The right options are identified, but for some there are warnings too.\n\n---------------------------------------------------------------------------------\nIntro: 0:00\nLampard \u0026 Tactics: 1:26\nFixtures: 4:18\nHamer: 6:02\nOther New Signings: 9:55\nWill there be more?: 16:34\nForwards: 17:34\nGoalkeepers: 22:32\nDefenders: 25:49\nGW2 v Hull: 30:42\n5.5 MIDs: 41:34\n5.0 MIDs: 42:53 \nPredicted Team GW 1 \u0026 2: 44:45\nSeason Expectations: 46:18\n----------------------------------------------------------------------------------\n\nNext on Correspondent Week: ep. 18 with Simon Bibby on Newcastle\n\nAnd later on Planet FPL: Correspondent Week episodes 19 \u0026 20 with Lauren Harris on Liverpool and Sean Norton on Everton\n\nAnd on Patreon: The Debrief with Suj and James on today's four Podcasts (IT+) and After The Podcast with today's Correspondents (AT)\n\nThe full schedule for Correspondent Week can be found here: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / correspondent-166192123⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  \n\nWant to become a member of our FPL community and support the Podcast? \n\nJoin us on Patreon: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow James on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfplpod⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Suj on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / sujanshah⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Clayton on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / claytsafc⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Nico on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / nico_semedo⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  \n\nSubscribe to our YouTube channel: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠   / @planetfpl  \n\nLike us on Facebook: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow us on Instagram: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\n#FantasyPremierLeague #FPL #Coventry","commandRuns":[{"startIndex":672,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwj_gdLl86uWAxW-484AHcCcIjrKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=9mjFuZGccD4","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"9mjFuZG