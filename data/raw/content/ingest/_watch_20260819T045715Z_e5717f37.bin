:{"simpleText":"179"},"label":{"simpleText":"Likes"},"accessibilityText":"179 likes","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964720,"raisedBackground":4294964720,"additiveBackground":566850373,"textPrimary":4281735434,"textSecondary":4285614903,"invertedBackground":4287578649,"overlayBackground":3426097418},"darkThemeColorPalette":{"baseBackground":4280027906,"raisedBackground":4281735434,"additiveBackground":734622533,"textPrimary":4294633952,"textSecondary":4292852906,"invertedBackground":4293107580,"overlayBackground":3426097418},"enableColorSampledText":true}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"Egs5bWpGdVpHY2NENCDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"4,762"},"label":{"simpleText":"Views"},"accessibilityText":"4,762 views","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964720,"raisedBackground":4294964720,"additiveBackground":566850373,"textPrimary":4281735434,"textSecondary":4285614903,"invertedBackground":4287578649,"overlayBackground":3426097418},"darkThemeColorPalette":{"baseBackground":4280027906,"raisedBackground":4281735434,"additiveBackground":734622533,"textPrimary":4294633952,"textSecondary":4292852906,"invertedBackground":4293107580,"overlayBackground":3426097418},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"Aug 14"},"label":{"simpleText":"2026"},"accessibilityText":"Aug 14, 2026","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964720,"raisedBackground":4294964720,"additiveBackground":566850373,"textPrimary":4281735434,"textSecondary":4285614903,"invertedBackground":4287578649,"overlayBackground":3426097418},"darkThemeColorPalette":{"baseBackground":4280027906,"raisedBackground":4281735434,"additiveBackground":734622533,"textPrimary":4294633952,"textSecondary":4292852906,"invertedBackground":4293107580,"overlayBackground":3426097418},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAciEwj_gdLl86uWAxW-484AHcCcIjrKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/@PlanetFPL","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UC8043oOKTB4uP8Nq15Kz6bg","canonicalBaseUrl":"/@PlanetFPL"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/ytc/AIdro_lhavFK4dKciK04L6ggAxAX9Q9_AnrPDcvbJCV1_3RdVQ=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"On the opening Podcast of the final day of Correspondent Week James is joined by Coventry fan Andrew O'Gorman to discuss all things about The Championship Winners ahead of next Friday's opener at Arsenal.\n\nBut it's the following week that will have FPL managers particularly interested, A Bench Boost GW2 strategy heavily involves a play to get the right Coventry assets for their game against Hull.\n\nAll the 4.0 defenders assessed, new signings covered, and there may be some 5.0 forwards starting the season. The right options are identified, but for some there are warnings too.\n\n---------------------------------------------------------------------------------\nIntro: 0:00\nLampard \u0026 Tactics: 1:26\nFixtures: 4:18\nHamer: 6:02\nOther New Signings: 9:55\nWill there be more?: 16:34\nForwards: 17:34\nGoalkeepers: 22:32\nDefenders: 25:49\nGW2 v Hull: 30:42\n5.5 MIDs: 41:34\n5.0 MIDs: 42:53 \nPredicted Team GW 1 \u0026 2: 44:45\nSeason Expectations: 46:18\n----------------------------------------------------------------------------------\n\nNext on Correspondent Week: ep. 18 with Simon Bibby on Newcastle\n\nAnd later on Planet FPL: Correspondent Week episodes 19 \u0026 20 with Lauren Harris on Liverpool and Sean Norton on Everton\n\nAnd on Patreon: The Debrief with Suj and James on today's four Podcasts (IT+) and After The Podcast with today's Correspondents (AT)\n\nThe full schedule for Correspondent Week can be found here: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / correspondent-166192123⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  \n\nWant to become a member of our FPL community and support the Podcast? \n\nJoin us on Patreon: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow James on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfplpod⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Suj on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / sujanshah⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Clayton on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / claytsafc⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow Nico on Twitter/x: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / nico_semedo⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  \n\nSubscribe to our YouTube channel: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠   / @planetfpl  \n\nLike us on Facebook: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\nFollow us on Instagram: ⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠  / planetfpl⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠⁠...  \n\n#FantasyPremierLeague #FPL #Coventry","commandRuns":[{"startIndex":672,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwj_gdLl86uWAxW-484AHcCcIjrKAQRcAMzJ","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=9mjFuZGccD4","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"9mjFuZGccD4","continuePlayback":true,"startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr5---sn-a5mekn6z.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026