nd":4281866248,"additiveBackground":734622278,"textPrimary":4294699487,"textSecondary":4293245604,"invertedBackground":4293107837,"overlayBackground":3426228232},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"Aug 12"},"label":{"simpleText":"2026"},"accessibilityText":"Aug 12, 2026","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964720,"raisedBackground":4294964720,"additiveBackground":566850118,"textPrimary":4281866248,"textSecondary":4286334764,"invertedBackground":4287578393,"overlayBackground":3426228232},"darkThemeColorPalette":{"baseBackground":4280093442,"raisedBackground":4281866248,"additiveBackground":734622278,"textPrimary":4294699487,"textSecondary":4293245604,"invertedBackground":4293107837,"overlayBackground":3426228232},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAciEwi9_Ped9quWAxW2UT8BHYoaNarKAQQIZ7zi","commandMetadata":{"webCommandMetadata":{"url":"/@FPLMate","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCweDAlFm2LnVcOqaFU4_AGA","canonicalBaseUrl":"/@FPLMate"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/qAQEk85x07sEvJWq1fo1ldbHQSKaIbTYlQF9ncIiym36qbHD1KLimJA2TQLtGmNYOZLaLyDTEA=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Win your league or your money back 👉 https://go.fantasyfootballhub.co.uk/l...\n\nIt's time to rate all of the best defender picks for Fantasy Premier League 2026/27 GW1!\n\nIn this video I will go through players in the defender position, and rank them in order of best to worst. Who are the best defs picks? Virgil, Gabriel or Pedro Porro for GW1? Or is there any differentials or cheap bargain picks? Hopefully these tips will help you decide which players to go for in your Gameweek 1 team selection squad.\n\n0:00 Intro\n0:55 £4.0m Defenders\n11:28 £4.5m Defenders\n18:17 £5.0m Defenders\n24:03 £5.5m Defenders\n29:35 £6.0m Defenders\n\nIf you like what you see, subscribe and become my latest mate!\n\n📧 Business enquiries: dan@fplmate.co.uk\n\n🐦   / fplmate  \n📸   / fplmate  \n🎶   / fplmate  \n🎮   / fpl_mate  \n👾   / discord  \n🏆 Join:    / @fplmate  \n️⚽️ FPL Mate league link: https://fantasy.premierleague.com/lea...\n️⚽️ FPL Mate league code: behupk\n\n#fpl #fantasypremierleague #premierleague","commandRuns":[{"startIndex":38,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwi9_Ped9quWAxW2UT8BHYoaNapIzM2wuPXCqOYVygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVElOZTN0QmpiUmJDMFNCSWJTei1MYnxBR3JiS2FsenBmN2FZeHc4cXBpNDFJMGl6ZzRBbFowWjRFbDJvWllERU5pcWpjdWZLWTBjUk1CY3hMVFg3QWRDU3o2NG1ha2pHbV8zYUo3d0lVa3E0YmdJaUZaNWdyT1BDanha\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Flanding%2Ffplmate%3Futm_source%3Daffiliate%26utm_medium%3Daffiliates%26utm_campaign%3DFPLMate%26utm_content%3Dyoutube%26via%3DFPLMate\u0026v=FcyiF1cMJsw","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVElOZTN0QmpiUmJDMFNCSWJTei1MYnxBR3JiS2FsenBmN2FZeHc4cXBpNDFJMGl6ZzRBbFowWjRFbDJvWllERU5pcWpjdWZLWTBjUk1CY3hMVFg3QWRDU3o2NG1ha2pHbV8zYUo3d0lVa3E0YmdJaUZaNWdyT1BDanha\u0026q=https%3A%2F%2Fgo.fantasyfootballhub.co.uk%2Flanding%2Ffplmate%3Futm_source%3Daffiliate%26utm_medium%3Daffiliates%26utm_campaign%3DFPLMate%26utm_content%3Dyoutube%26via%3DFPLMate\u0026v=FcyiF1cMJsw","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":508,"length":4,"onTap":{"innertubeCommand":{"