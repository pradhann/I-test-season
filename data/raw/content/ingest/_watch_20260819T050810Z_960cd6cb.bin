ate\n📸 https://www.instagram.com/FPLMate\n🎶 https://www.tiktok.com/@FPLMate\n🎮 https://www.twitch.tv/fpl_mate\n👾 https://discord.gg/rfVSeftbmx\n🏆 Join: https://www.youtube.com/channel/UCweDAlFm2LnVcOqaFU4_AGA/join\n️⚽️ FPL Mate league link: https://fantasy.premierleague.com/leagues/auto-join/behupk\n️⚽️ FPL Mate league code: behupk\n\n#fpl #fantasypremierleague #premierleague","isCrawlable":true,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/FcyiF1cMJsw/hqdefault.jpg?sqp=-oaymwEmCKgBEF5IWvKriqkDGQgBFQAAAAAYASUAAMhCPQCAokN4AbgC9xg=\u0026rs=AOn4CLA-SKkhzbXDgmepxBpogGjZA4i7CA","width":168,"height":94},{"url":"https://i.ytimg.com/vi/FcyiF1cMJsw/hqdefault.jpg?sqp=-oaymwEmCMQBEG5IWvKriqkDGQgBFQAAAAAYASUAAMhCPQCAokN4AbgC9xg=\u0026rs=AOn4CLDL7gKVA-CTuXWGTK69SXh-aaInVg","width":196,"height":110},{"url":"https://i.ytimg.com/vi/FcyiF1cMJsw/hqdefault.jpg?sqp=-oaymwEnCPYBEIoBSFryq4qpAxkIARUAAAAAGAElAADIQj0AgKJDeAG4AvcY\u0026rs=AOn4CLCLihS56iHF6yUnPhvoMzEkdznbZA","width":246,"height":138},{"url":"https://i.ytimg.com/vi/FcyiF1cMJsw/hqdefault.jpg?sqp=-oaymwEnCNACELwBSFryq4qpAxkIARUAAAAAGAElAADIQj0AgKJDeAG4AvcY\u0026rs=AOn4CLAQ72j5z35VrcPazm_FpfbBbKIe3w","width":336,"height":188},{"url":"https://i.ytimg.com/vi/FcyiF1cMJsw/maxresdefault.jpg","width":1920,"height":1080}]},"allowRatings":true,"viewCount":"54473","author":"FPL Mate","isPrivate":false,"isUnpluggedCorpus":false,"isLiveContent":false,"isTvfilmVideo":false},"annotations":[{"playerAnnotationsExpandedRenderer":{"featuredChannel":{"startTimeMs":"15000","endTimeMs":"2188000","watermark":{"thumbnails":[{"url":"https://i.ytimg.com/an/weDAlFm2LnVcOqaFU4_AGA/featured_channel.jpg?v=64f1aeae","width":40,"height":40}]},"trackingParams":"CBMQ8zciEwi47fed9quWAxWSxhYJHZgjCC8=","navigationEndpoint":{"clickTrackingParams":"CBMQ8zciEwi47fed9quWAxWSxhYJHZgjCC8yAml2ygEECGe84g==","commandMetadata":{"webCommandMetadata":{"url":"/channel/UCweDAlFm2LnVcOqaFU4_AGA","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/