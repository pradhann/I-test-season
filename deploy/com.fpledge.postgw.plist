<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- PARITY (PIPELINES.md §6.2, 2026-08-31): the settlement chain this job
       runs is now ALSO executed by the deadline-DAG tick as the
       post_gw_settlement registry task (fpl_edge/pipelines/registry.py,
       Calendar 10:30 UTC), iterating the same post_gw.settlement_steps list.
       This plist stays loaded during the parity window; every step is
       idempotent so the doubled daily run is safe. Retire it ONLY after the
       owner has watched a few days of matching outcomes (compare this job's
       post_gw_*.json reports against dag_firing/fetch_run rows for
       task='post_gw_settlement'). -->
  <key>Label</key><string>com.fpledge.postgw</string>
  <key>WorkingDirectory</key><string>/Users/nripeshpradhan/Documents/Github/i-test-season</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/nripeshpradhan/Documents/Github/i-test-season/.venv/bin/python</string>
    <string>-m</string><string>fpl_edge.jobs.post_gw</string>
  </array>
  <!-- Daily 03:00 LOCAL (launchd StartCalendarInterval is local-time only).
       The intent is "after FPL finalises points at 09:00 UK": from a US
       timezone, 03:00 local lands 10:00-11:00 UTC year-round, so the run
       most one day late and is a no-op otherwise (every step is idempotent). -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/nripeshpradhan/Library/Logs/fpledge/postgw.log</string>
  <key>StandardErrorPath</key><string>/Users/nripeshpradhan/Library/Logs/fpledge/postgw.log</string>
</dict>
</plist>
